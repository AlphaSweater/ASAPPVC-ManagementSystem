@{
	var controller = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").Trim();
	var action = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").Trim();
	var routeKey = $"{controller}/{action}";
	var excludedRoutes = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
	{
		"Auth/Login"
	};
	var explicitHide = ViewData["HideNavbar"] is bool b && b;
	var hideSidebar = explicitHide || excludedRoutes.Contains(routeKey);
	var current = routeKey.ToLowerInvariant();

	var isWarehouseOpen = current == "inventory/viewproductinventory"
								|| current == "inventory/viewcomponentinventory";
}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - ASAPPVC.UI</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/ASAPPVC.UI.styles.css" asp-append-version="true" />

	<style>
		:root {
			--sb-w: 240px;
		}

		html, body {
			height: 100%;
			margin: 0;
			font-family: "Montserrat",system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;
		}

		.sidebar {
			position: fixed;
			inset: 0 auto 0 0;
			width: var(--sb-w);
			display: flex;
			flex-direction: column;
			background: linear-gradient(180deg, #d63a3a 0%, #b52e2e 50%, #8f2424 100%);
			box-shadow: 6px 0 24px rgba(0,0,0,.18);
			z-index: 1000;
		}

		.sb-brand {
			display: flex;
			align-items: center;
			gap: 10px;
			padding: 16px;
		}

			.sb-brand img {
				width: 34px;
				height: 34px;
				object-fit: contain;
				border-radius: 8px;
			}

			.sb-brand .name {
				color: #fff;
				font-weight: 800;
				letter-spacing: .02em;
			}

		.sb-nav {
			display: flex;
			flex-direction: column;
			padding: 8px;
			overflow-y: auto;
		}

		.sb-item {
			position: relative;
			display: grid;
			grid-template-columns: 28px 1fr;
			align-items: center;
			gap: 12px;
			padding: 10px 12px;
			margin: 4px 6px;
			color: #ffffffcc;
			text-decoration: none;
			border-radius: 10px;
			transition: background .15s ease, color .15s ease;
		}

			.sb-item .sb-icon {
				font-size: 18px;
			}

			.sb-item .sb-label {
				font-weight: 600;
				letter-spacing: .01em;
			}

			.sb-item:hover {
				background: rgba(255,255,255,0.12);
				color: #fff;
			}

			.sb-item.active {
				background: rgba(255,255,255,0.18);
				color: #fff;
			}

				.sb-item.active::before {
					content: "";
					position: absolute;
					left: 0;
					top: 8px;
					bottom: 8px;
					width: 4px;
					border-radius: 2px;
					background: #fff;
				}

		.sb-group {
			margin: 4px 6px;
		}

		.sb-toggle {
			display: grid;
			grid-template-columns: 28px 1fr auto;
			align-items: center;
			gap: 12px;
			padding: 10px 12px;
			width: 100%;
			margin: 0;
			border: 0;
			border-radius: 10px;
			background: transparent;
			color: #ffffffcc;
			font-weight: 600;
			text-align: left;
			cursor: pointer;
			transition: background .15s ease, color .15s ease;
		}

			.sb-toggle:hover {
				background: rgba(255,255,255,0.12);
				color: #fff;
			}

		.sb-caret {
			transition: transform .15s ease;
		}

		.sb-group[aria-expanded="true"] .sb-caret {
			transform: rotate(180deg);
		}

		.sb-subnav {
			overflow: hidden;
			max-height: 0;
			transition: max-height .2s ease;
			margin-left: 34px; /* indent under icon column */
		}

		.sb-group[aria-expanded="true"] .sb-subnav {
			max-height: 400px;
		}

		.sb-subitem {
			display: block;
			color: #ffffffcc;
			text-decoration: none;
			padding: 8px 10px;
			margin: 4px 0;
			border-radius: 8px;
			transition: background .15s ease, color .15s ease;
		}

			.sb-subitem:hover {
				background: rgba(255,255,255,0.12);
				color: #fff;
			}

			.sb-subitem.active {
				background: rgba(255,255,255,0.18);
				color: #fff;
			}

		/* Main content */
		.main {
			min-height: 100%;
			padding: 20px;
			transition: margin-left .2s ease;
		}

		.has-sidebar .main {
			margin-left: var(--sb-w);
		}

		.no-sidebar .main {
			margin-left: 0;
		}

		/* (left as-is) Responsive collapse */
		.media (max-width: 900px) {
			: root

		{
			--sb-w: 78px;
		}

		.sb-item {
			grid-template-columns: 1fr;
			justify-items: center;
		}

		.sb-label {
			display: none;
		}

		}
	</style>
</head>
<body class="@(hideSidebar ? "no-sidebar" : "has-sidebar")">

	@if (!hideSidebar)
	{
		<aside class="sidebar">
			<div class="sb-brand">
				<img src="~/Assets/Images/Logos/asap-pvc-logo-dark.png" alt="ASAPPVC" />
				<span class="name">ASAPPVC</span>
			</div>

			<nav class="sb-nav">
				<a class="sb-item @(current == "home/index" ? "active" : "")" asp-controller="Home" asp-action="Index">
					<span class="sb-icon">🏠</span><span class="sb-label">Dashboard</span>
				</a>

				<a class="sb-item @(current == "customer/viewcustomer" ? "active" : "")" asp-controller="Customer" asp-action="ViewCustomer">
					<span class="sb-icon">👥</span><span class="sb-label">Manage Customers</span>
				</a>

				<section class="sb-group" aria-expanded="@(isWarehouseOpen ? "true" : "false")">
					<button type="button" class="sb-toggle" aria-controls="grp-warehouse" aria-expanded="@(isWarehouseOpen ? "true" : "false")">
						<span class="sb-icon">🏭</span>
						<span class="sb-label">Manage Warehouse</span>
						<span class="sb-caret">▾</span>
					</button>

					<div id="grp-warehouse" class="sb-subnav">
						<a class="sb-subitem @(current == "inventory/viewcomponentinventory" ? "active" : "")"
						   asp-controller="Inventory" asp-action="ViewComponentInventory">
							Manage Components
						</a>

						<a class="sb-subitem @(current == "inventory/viewproductinventory" ? "active" : "")"
						   asp-controller="Inventory" asp-action="ViewProductInventory">
							Manage Products
						</a>
					</div>
				</section>

				<a class="sb-item @(current == "order/vieworders" ? "active" : "")" asp-controller="Order" asp-action="ViewOrders">
					<span class="sb-icon">🚚</span><span class="sb-label">Manage Order</span>
				</a>
			</nav>
		</aside>
	}

	<div class="main">
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>

	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>

	<script>
		document.querySelectorAll('.sb-group').forEach(function (group) {
			var btn = group.querySelector('.sb-toggle');
			btn.addEventListener('click', function () {
				var open = group.getAttribute('aria-expanded') === 'true';
				group.setAttribute('aria-expanded', String(!open));
				btn.setAttribute('aria-expanded', String(!open));
			});
		});
	</script>

	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
