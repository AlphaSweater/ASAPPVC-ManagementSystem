@model ASAPPVC.UI.Models.OrderModel
@{
	ViewData["Title"] = $"Order #{Model.OrderID}";
}

<style>
	/* ---------- Root & Variables ---------- */
	:root {
		--primary-red: #d62828;
		--primary-blue: #0d47a1;
		--hover-red: #e03a3a;
		--text-light: #ffffff;
		--text-muted: rgba(255, 255, 255, 0.8);
	}

	/* ---------- Base & Background ---------- */
	* {
		box-sizing: border-box;
	}

	html, body {
		height: 100%;
		margin: 0;
		font-family: "Segoe UI", system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
	}

	body {
		background-color: #0d47a1;
		background-image: linear-gradient(120deg, var(--primary-blue) 0%, var(--primary-red) 100%);
		color: var(--text-light);
		position: relative;
		overflow-x: hidden;
		background-attachment: fixed;
	}

		/* ---------- Decorative Background Shapes ---------- */
		body::before, body::after {
			content: '';
			position: absolute;
			border-radius: 50%;
			filter: blur(150px);
			opacity: 0.6;
			z-index: -1;
		}

		body::before {
			background: var(--primary-blue);
			width: 350px;
			height: 350px;
			top: -80px;
			left: -120px;
		}

		body::after {
			background: var(--primary-red);
			width: 400px;
			height: 400px;
			bottom: -150px;
			right: -180px;
		}

	/* ---------- Main Content Layout ---------- */
	.viewport {
		padding: 40px 24px;
		min-height: 100vh;
	}

	.view-container {
		max-width: 960px;
		margin: 0 auto;
		background: rgba(255, 255, 255, 0.1);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border: 1px solid rgba(255, 255, 255, 0.2);
		box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
		border-radius: 16px;
		padding: 32px 40px;
	}

	/* ---------- HEADER ---------- */
	.header-section {
		margin-bottom: 32px;
		padding-bottom: 24px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.2);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--text-muted);
		text-decoration: none;
		font-weight: 600;
		font-size: 14px;
		margin-bottom: 16px;
		transition: color 0.2s ease;
	}

		.back-link:hover {
			color: var(--text-light);
		}

	.main-title {
		font-weight: 700;
		font-size: 28px;
		color: var(--text-light);
		margin: 0;
		text-align: center;
	}

	.header-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 16px;
	}

	.right-actions {
		flex-grow: 1;
		display: flex;
		justify-content: flex-end;
	}

	/* ---------- Order Details Grid ---------- */
	.order-details-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 24px;
		margin-bottom: 40px;
	}

	.info-card {
		background: rgba(0, 0, 0, 0.15);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 12px;
		padding: 20px;
	}

		.info-card .label {
			font-size: 14px;
			font-weight: 500;
			color: var(--text-muted);
			margin-bottom: 8px;
		}

		.info-card .value {
			font-size: 18px;
			font-weight: 600;
			color: var(--text-light);
		}

	/* ---------- Products Table Section ---------- */
	.products-section h3 {
		font-size: 20px;
		font-weight: 600;
		margin-bottom: 16px;
		padding-bottom: 16px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.2);
	}

	.table {
		width: 100%;
		border-collapse: collapse;
	}

		.table th, .table td {
			padding: 14px 16px;
			text-align: left;
			border-bottom: 1px solid rgba(255, 255, 255, 0.2);
		}

		.table thead th {
			font-size: 14px;
			font-weight: 700;
			color: var(--text-light);
			background-color: rgba(0, 0, 0, 0.15);
		}

		.table tbody tr {
			transition: background-color 0.2s ease;
		}

			.table tbody tr:hover {
				background-color: rgba(255, 255, 255, 0.08);
			}

		.table td {
			font-size: 15px;
			color: var(--text-muted);
		}

			.table td:first-child {
				color: var(--text-light);
				font-weight: 600;
			}

	.text-end {
		text-align: right;
	}

	.total-row td {
		font-weight: 700;
		font-size: 16px;
		border-bottom: none;
		padding-top: 16px;
	}

	/* ---------- Action Buttons ---------- */
	.actions {
		display: flex;
		justify-content: center;
		gap: 16px;
		margin-top: 40px;
	}

	.btn {
		height: 44px;
		padding: 0 24px;
		border-radius: 8px;
		font-weight: 600;
		font-size: 16px;
		cursor: pointer;
		border: none;
		transition: all .2s ease;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

		.btn:active {
			transform: scale(0.98);
		}

	.btn-primary {
		background: var(--primary-red);
		color: var(--text-light);
	}

		.btn-primary:hover {
			background: var(--hover-red);
		}

	.btn-secondary {
		background: transparent;
		color: var(--text-light);
		border: 1px solid rgba(255, 255, 255, 0.4);
	}

		.btn-secondary:hover {
			background: rgba(255, 255, 255, 0.1);
			border-color: rgba(255, 255, 255, 0.6);
		}
</style>

<div class="viewport">
	<div class="view-container">
		<div class="header-section">
			<a class="back-link" asp-action="ViewOrders">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="20" height="20" aria-hidden="true">
					<path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 010 1.06L9.81 10l2.98 2.97a.75.75 0 11-1.06 1.06l-3.5-3.5a.75.75 0 010-1.06l3.5-3.5a.75.75 0 011.06 0z" clip-rule="evenodd"></path>
				</svg>
				Back to Orders
			</a>

			<!-- New header row: left action, centered title -->
			<div class="header-row">
				<div class="main-title">
					<h2 class="main-title">Order #@Model.OrderID</h2>
				</div>
				<div class="right-actions">
					<a asp-action="CreatePickingSlip" asp-route-id="@Model.OrderID" class="btn btn-primary">Create Picking Slip</a>
				</div>
			</div>
		</div>

		<!-- Order Details Cards -->
		<div class="order-details-grid">
			<div class="info-card">
				<div class="label">Customer</div>
				<div class="value">@Model.Customer?.Name @Model.Customer?.Surname</div>
			</div>
			<div class="info-card">
				<div class="label">Order Date</div>
				<div class="value">@Model.OrderDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
			</div>
			<div class="info-card">
				<div class="label">Status</div>
				<div class="value">@Model.OrderStatus</div>
			</div>
		</div>

		<!-- Products in this Order -->
		<section class="products-section">
			<h3>Products</h3>
			@if ( Model.OrderProducts == null || !Model.OrderProducts.Any() ) {
				<p style="text-align:center; padding: 40px; color: var(--text-muted);">
					No products in this order.
				</p>
			}
			else {
				<table class="table">
					<thead>
						<tr>
							<th>Product</th>
							<th class="text-end" style="width:140px;">Price</th>
						</tr>
					</thead>
					<tbody>
						@{
							decimal total = 0;
							foreach ( var line in Model.OrderProducts ) {
								var price = line.Product?.Price ?? 0;
								total += price;
								<tr>
									<td>@line.Product?.Name</td>
									<td class="text-end">@price.ToString("C")</td>
								</tr>
							}
						}
						<tr class="total-row">
							<td class="text-end">Order Total:</td>
							<td class="text-end">@total.ToString("C")</td>
						</tr>
					</tbody>
				</table>
			}
		</section>
	</div>
</div>