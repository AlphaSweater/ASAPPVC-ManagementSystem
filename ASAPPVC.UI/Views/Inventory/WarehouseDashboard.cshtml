@{
    ViewData["Title"] = "Warehouse • Dashboard";
}

<link rel="stylesheet" href="~/css/views/inventory/WarehouseDashboard.css" asp-append-version="true" />

<div class="viewport">
    <div class="container">
        <!-- Header -->
        <header class="header">
            <div>
                <h1 class="title">Warehouse Dashboard</h1>
                <p class="subtitle">Quick actions for inventory operations</p>
            </div>
        </header>

        <!-- Actions -->
        <section class="actions-grid">
            <a class="action-card action-stock" asp-controller="StockTake" asp-action="StockTake">
                <div class="icon" aria-hidden="true">
                    <!-- Clipboard / checklist -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M9 2h6a2 2 0 0 1 2 2h1a2 2 0 0 1 2 2v13a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V6a2 2 0 0 1 2-2h1a2 2 0 0 1 2-2Zm0 2a1 1 0 0 0-1 1v1h8V5a1 1 0 0 0-1-1H9Zm0 6h6v2H9V10Zm0 4h6v2H9v-2ZM8 10H7v2h1v-2Zm0 4H7v2h1v-2Z" />
                    </svg>
                </div>
                <div class="text">
                    <h2>Stock Take</h2>
                    <p>Count and reconcile on-hand quantities.</p>
                </div>
                <span class="btn btn-primary">Open</span>
            </a>

            <a class="action-card action-receive" asp-controller="Inventory" asp-action="AddProductGet">
                <div class="icon" aria-hidden="true">
                    <!-- Truck / receiving -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M3 6a2 2 0 0 1 2-2h9v8h2.5a2 2 0 0 1 1.6.8l1.9 2.4a2 2 0 0 1 .4 1.2V19a1 1 0 0 1-1 1h-1a2.5 2.5 0 1 1-5 0H9.5a2.5 2.5 0 1 1-5 0H3a1 1 0 0 1-1-1V6Zm2 0v11h1.1a2.5 2.5 0 0 1 4.8 0H14V6H5Zm13.6 9-1.6-2H14v2h4.6ZM7.5 20a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm9 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" />
                    </svg>
                </div>
                <div class="text">
                    <h2>Receive Shipment</h2>
                    <p>Log new deliveries and update inventory.</p>
                </div>
                <span class="btn btn-accent">Open</span>
            </a>
        </section>
    </div>
</div>
