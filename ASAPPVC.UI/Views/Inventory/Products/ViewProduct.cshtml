@model ASAPPVC.UI.Models.Product
@{
	ViewData["Title"] = "View Product";

	// Pre-calculate the image source string for cleaner HTML
	string? imgSrc = null;
	if (Model?.ImageBytes != null && !string.IsNullOrEmpty(Model.ImageType))
	{
		imgSrc = $"data:{Model.ImageType};base64,{Convert.ToBase64String(Model.ImageBytes)}";
	}
}

<link rel="stylesheet" href="~/css/Views/Inventory/products/ViewProduct.css" asp-append-version="true" />

<div class="viewport">
	<div class="view-container">
		<div class="header-section">
			<a href="javascript:void(0);" class="back-link" onclick="window.history.back();">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="20" height="20" aria-hidden="true">
					<path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 010 1.06L9.81 10l2.98 2.97a.75.75 0 11-1.06 1.06l-3.5-3.5a.75.75 0 010-1.06l3.5-3.5a.75.75 0 011.06 0z" clip-rule="evenodd" />
				</svg>
				Back
			</a>
			<h2 class="main-title">@Model.Name</h2>
		</div>

		<div class="details-layout-grid">
			<!-- Image Column -->
			<div class="image-col">
				<div class="image-box">
					@if (!string.IsNullOrEmpty(imgSrc))
					{
						<img src="@imgSrc" alt="Product Image" />
					}
					else
					{
						<span class="no-image-text">No Image</span>
					}
				</div>
			</div>

			<!-- Details Column -->
			<div class="info-col">
				<div class="info-pair">
					<div class="label">Product Price</div>
					<div class="value price">@Model?.Price.ToString("C")</div>
				</div>
				<div class="info-pair">
					<div class="label">Description</div>
					<div class="value">@(string.IsNullOrEmpty(Model?.Description) ? "No description provided." : Model.Description)</div>
				</div>
			</div>
		</div>

		<!-- Parts in this Product -->
		<section class="parts-section">
			<h3>Parts in this Product</h3>
			<table class="table">
				<thead>
					<tr>
						<th>Part Name</th>
						<th class="align-right" style="width:120px;">Quantity</th>
						<th class="align-right" style="width:140px;">Unit Price</th>
						<th class="align-right" style="width:140px;">Subtotal</th>
					</tr>
				</thead>
				<tbody>
					@if (Model?.ProductComponents != null && Model.ProductComponents.Any())
					{
						decimal grandTotal = 0;
						foreach (var line in Model.ProductComponents)
						{
							var unitCost = line.Component?.UnitCost ?? 0;
							var subtotal = unitCost * line.QuantityRequired;
							grandTotal += subtotal;
							<tr>
								<td>@line.Component?.Name</td>
								<td class="align-right">@line.QuantityRequired</td>
								<td class="align-right">@unitCost.ToString("C")</td>
								<td class="align-right">@subtotal.ToString("C")</td>
							</tr>
						}
						<tr class="grand-total-row">
							<td colspan="3" class="align-right">Total Cost of Parts:</td>
							<td class="align-right">@grandTotal.ToString("C")</td>
						</tr>
					}
					else
					{
						<tr>
							<td colspan="4" style="text-align:center; padding: 24px; color: var(--text-muted);">
								No parts are linked to this product.
							</td>
						</tr>
					}
				</tbody>
			</table>
		</section>

		<!-- Footer Actions -->
		<div class="actions">
			<a class="btn btn-primary"
			   asp-controller="Inventory"
			   asp-action="EditProduct"
			   asp-route-id="@Model.Id">Edit Product</a>
		</div>
	</div>
</div>