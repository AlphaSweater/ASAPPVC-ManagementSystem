@model ASAPPVC.UI.Models.ProductModel
@{
    ViewData["Title"] = "View Product";

    // Pre-calculate the image source string for cleaner HTML
    string? imgSrc = null;
    if (Model?.ImageBytes != null && !string.IsNullOrEmpty(Model.ImageContentType))
    {
        imgSrc = $"data:{Model.ImageContentType};base64,{Convert.ToBase64String(Model.ImageBytes)}";
    }
}

<style>
    /* ---------- Root & Variables ---------- */
    :root {
        --primary-red: #d62828;
        --primary-blue: #0d47a1;
        --hover-red: #e03a3a;
        --text-light: #ffffff;
        --text-muted: rgba(255, 255, 255, 0.8);
    }

    /* ---------- Base & Background ---------- */
    * {
        box-sizing: border-box;
    }

    html, body {
        height: 100%;
        margin: 0;
        font-family: "Segoe UI", system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    }

    body {
        background-color: #0d47a1;
        background-image: linear-gradient(120deg, var(--primary-blue) 0%, var(--primary-red) 100%);
        color: var(--text-light);
        position: relative;
        overflow-x: hidden;
        background-attachment: fixed;
    }

        /* ---------- Decorative Background Shapes ---------- */
        body::before, body::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            filter: blur(150px);
            opacity: 0.6;
            z-index: -1;
        }

        body::before {
            background: var(--primary-blue);
            width: 350px;
            height: 350px;
            top: -80px;
            left: -120px;
        }

        body::after {
            background: var(--primary-red);
            width: 400px;
            height: 400px;
            bottom: -150px;
            right: -180px;
        }

    /* ---------- Main Content Layout ---------- */
    .viewport {
        padding: 40px 24px;
        min-height: 100vh;
    }

    .view-container {
        max-width: 960px;
        margin: 0 auto;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        border-radius: 16px;
        padding: 32px 40px;
    }

    /* ---------- HEADER ---------- */
    .header-section {
        margin-bottom: 32px;
        padding-bottom: 24px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--text-muted);
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 16px;
        transition: color 0.2s ease;
    }

        .back-link:hover {
            color: var(--text-light);
        }

    .main-title {
        font-weight: 700;
        font-size: 28px;
        color: var(--text-light);
        margin: 0;
    }

    /* ---------- Details Layout ---------- */
    .details-layout-grid {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 40px;
        align-items: flex-start;
        margin-bottom: 32px;
    }

    /* Image Column */
    .image-col .image-box {
        width: 100%;
        aspect-ratio: 1 / 1;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        background: rgba(0, 0, 0, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .image-col img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .image-col .no-image-text {
        font-style: italic;
        color: var(--text-muted);
    }

    /* Info Column */
    .info-col {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .info-pair .label {
        font-size: 14px;
        font-weight: 500;
        color: var(--text-muted);
        margin-bottom: 6px;
    }

    .info-pair .value {
        font-size: 18px;
        font-weight: 600;
        color: var(--text-light);
    }

    .info-pair .price {
        font-size: 24px;
        font-weight: 700;
        color: var(--text-light);
    }

    /* ---------- Parts Table Section ---------- */
    .parts-section h3 {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 16px;
        padding-bottom: 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }

    .table {
        width: 100%;
        border-collapse: collapse;
    }

        .table th, .table td {
            padding: 12px 10px;
            text-align: left;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        }

        .table thead th {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-muted);
        }

        .table td {
            font-size: 15px;
        }

    .align-right {
        text-align: right;
    }

    .grand-total-row td {
        font-weight: 700;
        font-size: 16px;
        border-bottom: none;
        padding-top: 16px;
    }

    /* ---------- Action Buttons ---------- */
    .actions {
        display: flex;
        justify-content: center;
        gap: 16px;
        margin-top: 40px;
    }

    .btn {
        height: 44px;
        padding: 0 24px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 16px;
        cursor: pointer;
        border: none;
        transition: all .2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .btn:active {
            transform: scale(0.98);
        }

    .btn-primary {
        background: var(--primary-red);
        color: var(--text-light);
    }

        .btn-primary:hover {
            background: var(--hover-red);
        }

</style>

<div class="viewport">
    <div class="view-container">
        <div class="header-section">
            <a href="javascript:void(0);" class="back-link" onclick="window.history.back();">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="20" height="20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 010 1.06L9.81 10l2.98 2.97a.75.75 0 11-1.06 1.06l-3.5-3.5a.75.75 0 010-1.06l3.5-3.5a.75.75 0 011.06 0z" clip-rule="evenodd" />
                </svg>
                Back
            </a>
            <h2 class="main-title">@Model.Name</h2>
        </div>

        <div class="details-layout-grid">
            <!-- Image Column -->
            <div class="image-col">
                <div class="image-box">
                    @if (!string.IsNullOrEmpty(imgSrc))
                    {
                        <img src="@imgSrc" alt="Product Image" />
                    }
                    else
                    {
                        <span class="no-image-text">No Image</span>
                    }
                </div>
            </div>

            <!-- Details Column -->
            <div class="info-col">
                <div class="info-pair">
                    <div class="label">Product Price</div>
                    <div class="value price">@Model?.Price.ToString("C")</div>
                </div>
                <div class="info-pair">
                    <div class="label">Description</div>
                    <div class="value">@(string.IsNullOrEmpty(Model?.Description) ? "No description provided." : Model.Description)</div>
                </div>
            </div>
        </div>

        <!-- Parts in this Product -->
        <section class="parts-section">
            <h3>Parts in this Product</h3>
            <table class="table">
                <thead>
                    <tr>
                        <th>Part Name</th>
                        <th class="align-right" style="width:120px;">Quantity</th>
                        <th class="align-right" style="width:140px;">Unit Price</th>
                        <th class="align-right" style="width:140px;">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.ProductParts != null && Model.ProductParts.Any())
                    {
                        decimal grandTotal = 0;
                        foreach (var line in Model.ProductParts)
                        {
                            var unitCost = line.Part?.UnitCost ?? 0;
                            var subtotal = unitCost * line.Quantity;
                            grandTotal += subtotal;
                            <tr>
                                <td>@line.Part?.Name</td>
                                <td class="align-right">@line.Quantity</td>
                                <td class="align-right">@unitCost.ToString("C")</td>
                                <td class="align-right">@subtotal.ToString("C")</td>
                            </tr>
                        }
                        <tr class="grand-total-row">
                            <td colspan="3" class="align-right">Total Cost of Parts:</td>
                            <td class="align-right">@grandTotal.ToString("C")</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" style="text-align:center; padding: 24px; color: var(--text-muted);">
                                No parts are linked to this product.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <!-- Footer Actions -->
        <div class="actions">
            <a class="btn btn-primary" asp-controller="Inventory" asp-action="EditProduct" asp-route-id="@Model.ProductID">Edit Product</a>
        </div>
    </div>
</div>