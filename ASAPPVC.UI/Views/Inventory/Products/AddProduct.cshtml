@{
    ViewData["Title"] = "Add New Product";
}

<style>
    /* ---------- Page Background ---------- */
    html, body {
        height: 100%;
        margin: 0;
        font-family: "Montserrat", system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
        background: linear-gradient(135deg, #215c99 0%, #252d6a 100%);
        color: #000;
    }

    .viewport {
        min-height: 100%;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 40px;
    }

    /* ---------- Container Layout ---------- */
    .addproduct-container { /* CHANGE: renamed from addpart-container */
        display: grid;
        grid-template-columns: 2fr 3fr;
        gap: 20px;
        background: #f9f9f9;
        border: 2px solid #c62929;
        border-radius: 12px;
        padding: 20px;
        max-width: 1100px; /* a bit wider to fit the parts table */
        width: 100%;
        box-shadow: 0 16px 40px rgba(0,0,0,.35);
    }

    /* ---------- Left Column (Image Upload) ---------- */
    .image-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
    }

    .image-box {
        width: 200px; /* a little larger for product */
        height: 200px;
        border: 2px solid rgba(198, 41, 41, 0.7);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: #fff;
    }

        .image-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .upload-btn {
        margin-top: 15px;
        width: 170px;
        height: 40px;
        border: none;
        border-radius: 8px;
        background: linear-gradient(135deg, #ef4723, #c62929);
        color: #fff;
        font-weight: 600;
        cursor: pointer;
        transition: filter .2s ease;
    }

        .upload-btn:hover {
            filter: brightness(1.1);
        }

    .hidden-file {
        display: none;
    }

    /* ---------- Right Column (Form Fields) ---------- */
    .form-section {
        padding: 10px;
    }

        .form-section h2 {
            font-size: 22px; /* CHANGE: “Add New Product” */
            font-weight: 700;
            margin-bottom: 15px;
            text-align: center;
            color: #333;
        }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

        .form-group label {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 5px;
            color: #555;
        }

        .form-group input, .form-group textarea, .form-group select {
            height: 38px;
            border: 1px solid rgba(198, 41, 41, 0.5);
            border-radius: 8px;
            padding: 0 10px;
            font-size: 14px;
            outline: none;
            background: #fff;
        }

        .form-group textarea {
            height: 80px;
            padding: 8px 10px;
            resize: vertical;
        }

            .form-group input:focus, .form-group textarea:focus, .form-group select:focus {
                border-color: #c62929;
                box-shadow: 0 0 0 2px rgba(198,41,41,0.2);
            }

    /* ---------- Parts Collection Card ---------- */
    .parts-card { /* CHANGE: new white card for parts collection */
        grid-column: 1 / -1; /* full width */
        background: #fff;
        color: #1a1a1a;
        border: 2px solid #c62929;
        border-radius: 12px;
        box-shadow: 0 16px 40px rgba(0,0,0,.15);
        padding: 12px;
        margin-top: 8px;
    }

        .parts-card h3 {
            margin: 4px 6px 10px;
            font-size: 18px;
            font-weight: 800;
            color: #333;
            text-align: center;
        }

    .parts-toolbar {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
        margin: 8px 6px 12px;
    }

    .btn-addrow {
        height: 34px;
        padding: 0 14px;
        border-radius: 8px;
        border: 0;
        background: linear-gradient(135deg, #ef4723, #c62929);
        color: #fff;
        font-weight: 700;
        cursor: pointer;
    }

        .btn-addrow:hover {
            filter: brightness(1.06);
        }

    .parts-table-wrap {
        overflow: auto;
    }

    .parts-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

        .parts-table thead th {
            position: sticky;
            top: 0;
            background: #fff;
            border-bottom: 2px solid #c62929;
            color: #333;
            font-weight: 800;
            text-align: left;
            padding: 10px 12px;
        }

        .parts-table tbody td {
            padding: 10px 12px;
            border-bottom: 1px dashed #f0d0d0;
        }

        .parts-table tfoot td {
            padding: 10px 12px;
            font-weight: 800;
            text-align: right;
        }

    .num {
        width: 110px;
        text-align: right;
    }

    .qty {
        width: 90px;
        text-align: right;
    }

    .remove-cell {
        width: 80px;
    }

    .btn-remove {
        height: 30px;
        padding: 0 10px;
        border-radius: 16px;
        border: 2px solid #c62929;
        background: #fff;
        color: #c62929;
        font-weight: 700;
        cursor: pointer;
    }

        .btn-remove:hover {
            background: #c62929;
            color: #fff;
        }

    .subtotal {
        min-width: 120px;
        text-align: right;
        font-weight: 700;
    }

    .grand {
        font-size: 16px;
        font-weight: 900;
    }

    /* ---------- Footer Buttons ---------- */
    .actions {
        grid-column: span 2;
        margin-top: 20px;
        display: flex;
        justify-content: center;
        gap: 15px;
    }

    .btn {
        width: 120px;
        height: 38px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: filter .2s ease;
    }

    .btn-save {
        background: linear-gradient(135deg, #ef4723, #c62929);
        color: #fff;
    }

    .btn-reset {
        background: #ddd;
        color: #333;
    }

    .btn:hover {
        filter: brightness(1.1);
    }

    /* small responsive tweak */
    .media (max-width: 980px) {
        .addproduct-container

    {
        grid-template-columns: 1fr;
    }

    .image-section {
        order: -1;
    }

    }
</style>

<div class="viewport">
    <div class="addproduct-container">
        <!-- Left: Image Upload -->
        <div class="image-section">
            <div class="image-box">
                <img id="previewImg" src="~/Assets/Images/placeholder.png" alt="Product Image" />
            </div>
            <label class="upload-btn" for="imageFile">Upload Image</label>
            <input id="imageFile" name="ImageFile" type="file" accept="image/*" class="hidden-file" form="addProductForm" />
        </div>

        <!-- Right: Form -->
        <div class="form-section">
            <h2>Add New Product</h2> <!-- CHANGE: Product -->
            <form id="addProductForm" asp-controller="Products" asp-action="Add" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="form-grid">
                    <!-- Basic product info -->
                    <div class="form-group">
                        <label>Product Name</label> <!-- CHANGE -->
                        <input type="text" name="ProductName" placeholder="Enter product name" />
                    </div>
                    <div class="form-group">
                        <label>SKU</label> <!-- CHANGE -->
                        <input type="text" name="Sku" placeholder="Enter SKU" />
                    </div>
                    <div class="form-group">
                        <label>Base Price</label> <!-- CHANGE -->
                        <input type="number" step="0.01" name="BasePrice" placeholder="Enter base price" />
                    </div>
                    <div class="form-group">
                        <label>Description (optional)</label> <!-- CHANGE -->
                        <textarea name="Description" placeholder="Short description"></textarea>
                    </div>

                    <!-- Parts collection -->
                    <div class="parts-card">
                        <h3>Parts in this Product</h3>
                        <div class="parts-toolbar">
                            <!-- You can replace this simple Add Row with a search/lookup later -->
                            <button type="button" class="btn-addrow" id="addRowBtn">+ Add Part</button> <!-- CHANGE -->
                        </div>

                        <div class="parts-table-wrap">
                            <table class="parts-table" id="partsTable">
                                <thead>
                                    <tr>
                                        <th style="min-width:160px;">Part</th>
                                        <th class="qty">Qty</th>
                                        <th class="num">Unit Price</th>
                                        <th class="subtotal">Subtotal</th>
                                        <th class="remove-cell"></th>
                                    </tr>
                                </thead>
                                <tbody id="partsTbody">
                                    <!-- Initial empty row for UX (index 0) -->
                                    <tr data-index="0">
                                        <!-- For model binding: Parts[0].PartId -->
                                        <td>
                                            <!-- Replace this select with your real parts list -->
                                            <select name="Parts[0].PartId">
                                                <option value="">-- Select part --</option>
                                                <option value="101">PVC Elbow 32mm</option>
                                                <option value="102">PVC Tee 50mm</option>
                                                <option value="103">End Cap 20mm</option>
                                            </select>
                                        </td>
                                        <td>
                                            <input class="qty" type="number" name="Parts[0].Quantity" value="1" min="1" />
                                        </td>
                                        <td>
                                            <input class="num unit" type="number" name="Parts[0].UnitPrice" step="0.01" value="0.00" />
                                        </td>
                                        <td class="subtotal">0.00</td>
                                        <td class="remove-cell">
                                            <button type="button" class="btn-remove">Remove</button>
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3" style="text-align:right;">Grand Total:</td>
                                        <td class="subtotal grand" id="grandTotal">0.00</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="actions">
                        <button type="submit" class="btn btn-save">Save Product</button> <!-- CHANGE -->
                        <button type="reset" class="btn btn-reset">Reset</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    (function(){
        /* Image preview */
        const fileInput = document.getElementById('imageFile');
        const preview   = document.getElementById('previewImg');
        if (fileInput) {
            fileInput.addEventListener('change', function(){
                const f = this.files && this.files[0];
                if (!f) return;
                const reader = new FileReader();
                reader.onload = e => preview.src = e.target.result;
                reader.readAsDataURL(f);
            });
        }

        /* Parts dynamic rows + totals */
        const tbody = document.getElementById('partsTbody');
        const addRowBtn = document.getElementById('addRowBtn');
        const grandEl = document.getElementById('grandTotal');

        function recalcRow(tr){
            const qty  = parseFloat(tr.querySelector('input.qty')?.value || '0');
            const unit = parseFloat(tr.querySelector('input.unit')?.value || '0');
            const subtotal = (qty * unit) || 0;
            const td = tr.querySelector('.subtotal');
            if (td) td.textContent = subtotal.toFixed(2);
            return subtotal;
        }

        function recalcGrand(){
            let sum = 0;
            tbody.querySelectorAll('tr').forEach(tr => sum += recalcRow(tr));
            if (grandEl) grandEl.textContent = sum.toFixed(2);
        }

        function wireRowEvents(tr){
            tr.addEventListener('input', e => {
                if (e.target.matches('input.qty, input.unit')) recalcGrand();
            });
            const removeBtn = tr.querySelector('.btn-remove');
            if (removeBtn) removeBtn.addEventListener('click', () => {
                tr.remove();
                renumberIndexes();
                recalcGrand();
            });
        }

        function createRow(index){
            const tr = document.createElement('tr');
            tr.setAttribute('data-index', index);
            tr.innerHTML = `
                <td>
                    <select name="Parts[${index}].PartId">
                        <option value="">-- Select part --</option>
                        <option value="101">PVC Elbow 32mm</option>
                        <option value="102">PVC Tee 50mm</option>
                        <option value="103">End Cap 20mm</option>
                    </select>
                </td>
                <td>
                    <input class="qty" type="number" name="Parts[${index}].Quantity" value="1" min="1" />
                </td>
                <td>
                    <input class="num unit" type="number" name="Parts[${index}].UnitPrice" step="0.01" value="0.00" />
                </td>
                <td class="subtotal">0.00</td>
                <td class="remove-cell"><button type="button" class="btn-remove">Remove</button></td>
            `;
            wireRowEvents(tr);
            return tr;
        }

        function renumberIndexes(){
            const rows = Array.from(tbody.querySelectorAll('tr'));
            rows.forEach((tr, i) => {
                tr.setAttribute('data-index', i);
                // update name attributes to Parts[i].*
                tr.querySelectorAll('select, input').forEach(inp => {
                    if (!inp.name) return;
                    inp.name = inp.name.replace(/Parts\[\d+\]/, `Parts[${i}]`);
                });
            });
        }

        if (addRowBtn) {
            addRowBtn.addEventListener('click', () => {
                const next = tbody.querySelectorAll('tr').length;
                tbody.appendChild(createRow(next));
            });
        }

        // wire initial row
        tbody.querySelectorAll('tr').forEach(wireRowEvents);
        recalcGrand();
    })();
</script>
