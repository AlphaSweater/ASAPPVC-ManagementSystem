@model ASAPPVC.UI.Models.ViewModels.Inventory.CreateComponentViewModel
@{
	ViewData["Title"] = "Add New Component";
}

<style>
	/* ---------- Root & Variables ---------- */
	:root {
		--primary-red: #d62828;
		--primary-blue: #0d47a1;
		--hover-red: #e03a3a;
		--text-light: #ffffff;
		--text-muted: rgba(255, 255, 255, 0.8);
		--accent-orange: #ef4723;
	}

	/* ---------- Base & Background ---------- */
	* {
		box-sizing: border-box;
	}

	html, body {
		height: 100%;
		margin: 0;
		font-family: "Segoe UI", system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
	}

	body {
		background-color: #0d47a1;
		background-image: linear-gradient(120deg, var(--primary-blue) 0%, var(--primary-red) 100%);
		color: var(--text-light);
		position: relative;
		overflow-x: hidden;
		background-attachment: fixed;
	}

		/* ---------- Decorative Background Shapes ---------- */
		body::before, body::after {
			content: '';
			position: absolute;
			border-radius: 50%;
			filter: blur(150px);
			opacity: 0.6;
			z-index: -1;
		}

		body::before {
			background: var(--primary-blue);
			width: 350px;
			height: 350px;
			top: -80px;
			left: -120px;
		}

		body::after {
			background: var(--primary-red);
			width: 400px;
			height: 400px;
			bottom: -150px;
			right: -180px;
		}

	/* ---------- Main Content Layout ---------- */
	.viewport {
		padding: 40px 24px;
		min-height: 100vh;
	}

	.form-container {
		max-width: 920px;
		margin: 0 auto;
		background: rgba(255, 255, 255, 0.1);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border: 1px solid rgba(255, 255, 255, 0.2);
		box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
		border-radius: 16px;
		padding: 32px 40px;
	}

	/* ---------- HEADER ---------- */
	.form-header-section {
		margin-bottom: 32px;
		padding-bottom: 24px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.2);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--text-muted);
		text-decoration: none;
		font-weight: 600;
		font-size: 14px;
		margin-bottom: 16px;
		transition: color 0.2s ease;
	}

		.back-link:hover {
			color: var(--text-light);
		}

	.main-title {
		font-weight: 700;
		font-size: 28px;
		color: var(--text-light);
		margin: 0;
	}

	/* ---------- Form Grid & Elements ---------- */
	.form-layout-grid {
		display: grid;
		grid-template-columns: 1fr 2fr; /* Columns for image and form */
		gap: 40px;
		align-items: start;
	}

	.form-fields-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 24px 20px;
	}

	.group {
		display: flex;
		flex-direction: column;
	}

		.group.full-width {
			grid-column: 1 / -1;
		}

	.label {
		font-size: 14px;
		font-weight: 500;
		color: var(--text-light);
		margin-bottom: 8px;
	}

	.input {
		height: 44px;
		font-size: 16px;
		color: var(--text-light);
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: 8px;
		padding: 0 12px;
		outline: none;
		transition: border-color 0.3s ease, background-color 0.3s ease;
	}

		.input::placeholder {
			color: rgba(255, 255, 255, 0.5);
		}

		.input:focus {
			border-color: rgba(255, 255, 255, 0.7);
			background: rgba(255, 255, 255, 0.1);
		}

	.text-danger {
		color: #ffcdd2;
		font-size: 12px;
		margin-top: 6px;
	}

	/* ---------- Image Upload Section ---------- */
	.image-upload-section {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		margin-top: 10px;
	}

	.image-box {
		width: 200px;
		height: 200px;
		border-radius: 12px;
		border: 1px solid rgba(255, 255, 255, 0.3);
		background: rgba(255, 255, 255, 0.05);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		cursor: pointer;
		transition: background-color 0.2s;
	}

		.image-box:hover {
			background: rgba(255, 255, 255, 0.1);
		}

		.image-box img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

	.hidden-file-input {
		display: none;
	}

	/* ---------- Action Buttons ---------- */
	.actions {
		display: flex;
		justify-content: center;
		gap: 16px;
		margin-top: 32px;
		grid-column: 1 / -1;
	}

	.btn {
		height: 44px;
		padding: 0 24px;
		border-radius: 8px;
		font-weight: 600;
		font-size: 16px;
		cursor: pointer;
		border: none;
		transition: all .2s ease;
		text-decoration: none;
	}

		.btn:active {
			transform: scale(0.98);
		}

	.btn-primary {
		background: var(--primary-red);
		color: var(--text-light);
	}

		.btn-primary:hover {
			background: var(--hover-red);
		}

	.btn-secondary {
		background: transparent;
		color: var(--text-light);
		border: 1px solid rgba(255, 255, 255, 0.4);
	}

		.btn-secondary:hover {
			background: rgba(255, 255, 255, 0.1);
			border-color: rgba(255, 255, 255, 0.6);
		}
</style>

<div class="viewport">
	<div class="form-container">
		<!-- HEADER SECTION -->
		<div class="form-header-section">
			<a class="back-link" asp-controller="Inventory" asp-action="ViewComponentInventory">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="20" height="20" aria-hidden="true">
					<path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 010 1.06L9.81 10l2.98 2.97a.75.75 0 11-1.06 1.06l-3.5-3.5a.75.75 0 010-1.06l3.5-3.5a.75.75 0 011.06 0z" clip-rule="evenodd" />
				</svg>
				Back to Inventory
			</a>
			<h2 class="main-title">@ViewData["Title"]</h2>
		</div>

		<form id="addComponentForm"
			  asp-controller="Inventory"
			  asp-action="AddComponent"
			  method="post"
			  enctype="multipart/form-data">
			@Html.AntiForgeryToken()
			<div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:12px; text-align:center;"></div>

			<div class="form-layout-grid">
				<!-- Left: Image Upload -->
				<div class="image-upload-section">
					<div class="image-box" onclick="document.getElementById('imageFile').click();">
						<img id="previewImg" src="~/Assets/Images/placeholder.png" alt="Component Image Preview" />
					</div>
					<button type="button" class="btn btn-secondary" onclick="document.getElementById('imageFile').click();">
						Upload Image
					</button>
					<input id="imageFile" asp-for="ImageFile" type="file" accept="image/*" class="hidden-file-input" />
					<span asp-validation-for="ImageFile" class="text-danger"></span>
				</div>

				<!-- Right: Form -->
				<div class="form-fields-grid">
					<div class="group">
						<label asp-for="Name" class="label"></label>
						<input asp-for="Name" class="input" placeholder="e.g. Resistor 10k Ohm" />
						<span asp-validation-for="Name" class="text-danger"></span>
					</div>

					<div class="group">
						<label asp-for="StorageLocation" class="label"></label>
						<input asp-for="StorageLocation" class="input" placeholder="e.g. Bin A-01" />
						<span asp-validation-for="StorageLocation" class="text-danger"></span>
					</div>

					<div class="group">
						<label asp-for="UnitCost" class="label"></label>
						<input asp-for="UnitCost" class="input" step="0.01" inputmode="decimal" placeholder="e.g. 15.50" />
						<span asp-validation-for="UnitCost" class="text-danger"></span>
					</div>

					<div class="group">
						<label asp-for="CurrentAmount" class="label"></label>
						<input asp-for="CurrentAmount" class="input" type="number" placeholder="e.g. 100" />
						<span asp-validation-for="CurrentAmount" class="text-danger"></span>
					</div>

					<div class="actions">
						<button type="submit" class="btn btn-primary">Save Component</button>
						<button type="reset" class="btn btn-secondary">Reset</button>
					</div>
				</div>
			</div>
		</form>
	</div>
</div>

<script>
	(() => {
		const input = document.getElementById('imageFile');
		const img = document.getElementById('previewImg');

		if (input && img) {
			input.addEventListener('change', () => {
				const f = input.files && input.files[0];
				if (!f) return;

				const reader = new FileReader();
				reader.onload = e => { img.src = e.target.result; };
				reader.readAsDataURL(f);
			});
		}
	})();
</script>