@* Optional strongly-typed model (you can remove if you prefer ViewBag) *@
@* @model ASAPPVC.UI.Models.PartViewModel *@
@{
    ViewData["Title"] = "View Part";
    // Fallbacks if you aren't passing a model yet:
    var img = Model?.ImageUrl ?? Url.Content("~/Assets/Images/placeholder.png");
    var name = Model?.PartName ?? "—";
    var loc = Model?.StorageLocation ?? "—";
    var cpu = Model?.PricePerUnit?.ToString("0.00") ?? "—";
    var qty = Model?.StockQuantity?.ToString() ?? "—";
    var min = Model?.MinimumStockLevel?.ToString() ?? "—";
}

<style>
    /* ---------- Page Background ---------- */
    html, body {
        height: 100%;
        margin: 0;
        font-family: "Montserrat", system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
        background: linear-gradient(135deg, #215c99 0%, #252d6a 100%);
        color: #000;
    }

    .viewport {
        min-height: 100%;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 40px 24px;
    }

    /* ---------- Card Container (outer shell) ---------- */
    .viewpart-card {
        display: grid;
        grid-template-columns: 2fr 3fr;
        gap: 20px;
        width: 100%;
        max-width: 960px;
        background: #f9f9f9; /* light background */
        border: 2px solid #c62929; /* red outline */
        border-radius: 12px;
        box-shadow: 0 16px 40px rgba(0,0,0,.35);
        padding: 20px;
    }

    /* ---------- Header Row ---------- */
    .header {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        margin-bottom: 8px;
    }

    .back-link {
        justify-self: start;
        appearance: none;
        background: transparent;
        border: 0;
        color: #c62929;
        font-weight: 700;
        cursor: pointer;
        padding: 8px 0;
        text-decoration: none;
    }

    .title {
        justify-self: center;
        font-size: 24px;
        font-weight: 700;
        color: #333;
    }

    /* ---------- Image Column ---------- */
    .image-col {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 10px;
    }

    .image-box {
        width: 180px;
        height: 180px;
        border: 2px solid rgba(255, 0, 0, 0.7);
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
        display: grid;
        place-items: center;
    }

        .image-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* ---------- Details Column ---------- */
    .details-col {
        padding: 10px;
        border: 2px solid rgba(255, 0, 0, 0.7);
        border-radius: 10px;
        background: #fff;
    }

    .details-title {
        font-size: 18px;
        font-weight: 700;
        color: #333;
        margin: 0 0 12px 0;
        text-align: center;
    }

    .details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr; 
        gap: 14px 20px;
    }

    .pair {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .label {
        font-size: 13px;
        font-weight: 600;
        color: #555;
    }

    .value {
        font-size: 15px;
        font-weight: 600;
        color: #222;
    }

    /* ---------- Footer Actions ---------- */
    .footer {
        grid-column: 2; 
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 14px;
    }

    .btn {
        min-width: 100px;
        height: 38px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: filter .2s ease;
    }

    .btn-edit {
        background: linear-gradient(135deg, #ef4723, #c62929);
        color: #fff;
    }

    .btn:hover {
        filter: brightness(1.08);
    }

    /* ---------- Responsive ---------- */
    .media (max-width: 820px) {
        .viewpart-card

    {
        grid-template-columns: 1fr;
    }

    .footer {
        grid-column: 1;
    }

    }
</style>

<div class="viewport">
    <section class="viewpart-card">
        <!-- Header -->
        <div class="header">
            <!-- Back: either JS history or a route -->
            <a href="javascript:history.back()" class="back-link">← Back</a>
            <div class="title">View Part</div>
        </div>

        <!-- Image Column -->
        <div class="image-col">
            <div class="image-box">
                <img src="@img" alt="Part Image" />
            </div>
        </div>

        <!-- Details Column -->
        <div class="details-col">
            <h2 class="details-title">Part Details</h2>
            <div class="details-grid">
                <div class="pair">
                    <div class="label">Part Name:</div>
                    <div class="value">@name</div>
                </div>
                <div class="pair">
                    <div class="label">Storage Location:</div>
                    <div class="value">@loc</div>
                </div>
                <div class="pair">
                    <div class="label">Cost per Unit:</div>
                    <div class="value">@cpu</div>
                </div>
                <div class="pair">
                    <div class="label">Current Stock Amount:</div>
                    <div class="value">@qty</div>
                </div>
                <div class="pair">
                    <div class="label">Restock Value:</div>
                    <div class="value">@min</div>
                </div>
            </div>
        </div>

        <!-- Footer Actions -->
        <div class="footer">
            <form asp-controller="Parts" asp-action="Edit" method="get">
                @* For GET edit?id=... if you have an Id *@
                @* <input type="hidden" name="id" value="@Model?.Id" /> *@
                <button type="submit" class="btn btn-edit">Edit</button>
            </form>
        </div>
    </section>
</div>
