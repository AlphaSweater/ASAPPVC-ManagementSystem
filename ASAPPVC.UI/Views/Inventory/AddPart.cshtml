@{
    ViewData["Title"] = "Add New Part";
}

<style>
    /* ---------- Page Background ---------- */
    html, body {
        height: 100%;
        margin: 0;
        font-family: "Montserrat", system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
        background: linear-gradient(135deg, #215c99 0%, #252d6a 100%);
        color: #000;
    }

    .viewport {
        min-height: 100%;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 40px;
    }

    /* ---------- Container Layout ---------- */
    .addpart-container {
        display: grid;
        grid-template-columns: 2fr 3fr;
        gap: 20px;
        background: #f9f9f9;
        border: 2px solid #c62929;
        border-radius: 12px;
        padding: 20px;
        max-width: 960px;
        width: 100%;
        box-shadow: 0 16px 40px rgba(0,0,0,.35);
    }

    /* ---------- Left Column (Image Upload) ---------- */
    .image-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .image-box {
        width: 180px;
        height: 180px;
        border: 2px solid rgba(255, 0, 0, 0.7);
        border-radius: 10px ;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: #fff;
    }

        .image-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .upload-btn {
        margin-top: 15px;
        width: 150px;
        height: 40px;
        border: none;
        border-radius: 8px;
        background: linear-gradient(135deg, #ef4723, #c62929);
        color: #fff;
        font-weight: 600;
        cursor: pointer;
        transition: filter .2s ease;
    }

        .upload-btn:hover {
            filter: brightness(1.1);
        }

    /* ---------- Right Column (Form Fields) ---------- */
    .form-section {
        padding: 10px;
    }

        .form-section h2 {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 15px;
            text-align: center;
            color: #333;
        }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

        .form-group label {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 5px;
            color: #555;
        }

        .form-group input {
            height: 38px;
            border: 1px solid #ccc;
            border: 1px solid rgba(198, 41, 41, 0.5);
            border-radius: 8px;
            padding: 0 10px;
            font-size: 14px;
            outline: none;
        }

            .form-group input:focus {
                border-color: #c62929;
                box-shadow: 0 0 0 2px rgba(198,41,41,0.2);
            }

    /* ---------- Footer Buttons ---------- */
    .actions {
        grid-column: span 2;
        margin-top: 20px;
        display: flex;
        justify-content: center;
        gap: 15px;
    }

    .btn {
        width: 100px;
        height: 38px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: filter .2s ease;
    }

    .btn-save {
        background: linear-gradient(135deg, #ef4723, #c62929);
        color: #fff;
    }

    .btn-reset {
        background: #ddd;
        color: #333;
    }

    .btn:hover {
        filter: brightness(1.1);
    }
</style>

<div class="viewport">
    <div class="addpart-container">
        <!-- Left: Image Upload -->
        <div class="image-section">
            <div class="image-box">
                <img src="~/Assets/Images/placeholder.png" alt="Part Image" />
            </div>
            <button type="button" class="upload-btn">Upload Image</button>
        </div>

        <!-- Right: Form -->
        <div class="form-section">
            <h2>Add New Part</h2>
            <form asp-controller="Parts" asp-action="Add" method="post">
                @Html.AntiForgeryToken()
                <div class="form-grid">
                    <div class="form-group">
                        <label>Part Name</label>
                        <input type="text" name="PartName" placeholder="Enter part name" />
                    </div>
                    <div class="form-group">
                        <label>Storage Location</label>
                        <input type="text" name="StorageLocation" placeholder="Enter storage location" />
                    </div>
                    <div class="form-group">
                        <label>Cost per Unit</label>
                        <input type="number" step="0.01" name="PricePerUnit" placeholder="Enter cost per unit" />
                    </div>
                    <div class="form-group">
                        <label>Current Stock Amount</label>
                        <input type="number" name="StockQuantity" placeholder="Enter stock amount" />
                    </div>
                    <div class="form-group">
                        <label>Restock Value</label>
                        <input type="number" name="MinimumStockLevel" placeholder="Enter restock value" />
                    </div>

                    <!-- Action Buttons -->
                    <div class="actions">
                        <button type="submit" class="btn btn-save">Save</button>
                        <button type="reset" class="btn btn-reset">Reset</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
