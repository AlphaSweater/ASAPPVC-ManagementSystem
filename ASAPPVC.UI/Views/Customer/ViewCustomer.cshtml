@model List<ASAPPVC.UI.Models.CustomerModel>
@{
    ViewData["Title"] = "Customers";
}

<style>
    :root {
        --primary-red: #d62828;
        --primary-blue: #0d47a1;
        --hover-red: #e03a3a;
        --text-light: #ffffff;
        --text-muted: rgba(255, 255, 255, 0.8);
    }

    /* ---------- Base & Background ---------- */
    html, body {
        height: 100%;
        margin: 0;
        font-family: "Segoe UI", system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    }

    body {
        background-color: #0d47a1;
        background-image: linear-gradient(120deg, var(--primary-blue) 0%, var(--primary-red) 100%);
        color: var(--text-light);
        position: relative;
        overflow-x: hidden;
        background-attachment: fixed;
    }

    * {
        box-sizing: border-box;
    }

    /* ---------- Decorative Background Shapes ---------- */
    body::before, body::after {
        content: '';
        position: absolute;
        border-radius: 50%;
        filter: blur(150px);
        opacity: 0.6;
        z-index: -1;
    }

    body::before {
        background: var(--primary-blue);
        width: 350px;
        height: 350px;
        top: -80px;
        left: -120px;
    }

    body::after {
        background: var(--primary-red);
        width: 400px;
        height: 400px;
        bottom: -150px;
        right: -180px;
    }

    /* ---------- Main Content Layout ---------- */
    .viewport {
        padding: 40px 24px;
        min-height: 100vh;
    }

    .list-container {
        max-width: 1200px; 
        margin: 0 auto;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        border-radius: 16px;
        padding: 24px 32px;
    }

    /* ---------- Toolbar ---------- */
    .toolbar {
        display: flex;
        flex-wrap: wrap; /* Allow wrapping on smaller screens */
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
    }

    .search-form {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .search-input {
        height: 44px;
        width: 320px;
        max-width: 100%;
        font-size: 16px;
        color: var(--text-light);
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 8px;
        padding: 0 12px;
        outline: none;
        transition: border-color 0.3s ease, background-color 0.3s ease;
    }

        .search-input::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

        .search-input:focus {
            border-color: rgba(255, 255, 255, 0.7);
            background: rgba(255, 255, 255, 0.1);
        }

    /* ---------- Buttons (Re-used from Create view) ---------- */
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 44px;
        padding: 0 24px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 16px;
        cursor: pointer;
        border: none;
        text-decoration: none; /* For <a> tags */
        transition: all .2s ease;
    }

        .btn:active {
            transform: scale(0.98);
        }

    .btn-primary {
        background: var(--primary-red);
        color: var(--text-light);
    }

        .btn-primary:hover {
            background: var(--hover-red);
        }

    .btn-secondary {
        background: transparent;
        color: var(--text-light);
        border: 1px solid rgba(255, 255, 255, 0.4);
    }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.6);
        }

    /* ---------- TABLE REDESIGN ---------- */
    .table-section {
        overflow-x: auto; /* Allow horizontal scrolling on small screens */
    }

    .table {
        width: 100%;
        border-collapse: collapse;
        border-spacing: 0;
    }

    thead th {
        position: sticky;
        top: 0;
        background: rgba(0, 0, 0, 0.2);
        color: var(--text-light);
        text-align: left;
        font-weight: 600;
        padding: 14px 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }

    tbody td {
        padding: 14px 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--text-muted);
    }

    tbody tr {
        transition: background-color 0.15s ease;
    }

        tbody tr:hover {
            background: rgba(255, 255, 255, 0.05);
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

</style>

<div class="viewport">
    <div class="list-container">
        <!-- Toolbar -->
        <div class="toolbar">
            <form class="search-form" asp-controller="Customers" asp-action="Index" method="get">
                <input class="search-input" type="text" name="q" placeholder="Search customers..." value="@Context.Request.Query["q"]" />
                <button class="btn btn-secondary" type="submit">Search</button>
            </form>
            <a href="@Url.Action("CreateCustomer", "Customer")" class="btn btn-primary">Create New Customer</a>
        </div>

        <!-- Table -->
        <section class="table-section">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width:10%;">ID</th>
                        <th>First name</th>
                        <th>Last name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Company</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" style="padding: 24px; text-align: center; color: var(--text-muted);">
                                No customers found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var c in Model)
                        {
                            <tr>
                                <td>@c.CustomerID</td>
                                <td>@c.Name</td>
                                <td>@c.Surname</td>
                                <td>@c.PhoneNumber</td>
                                <td>@c.Email</td>
                                <td>@(string.IsNullOrWhiteSpace(c.Company) ? "—" : c.Company)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </section>
    </div>
</div>