@model List<ASAPPVC.UI.Models.Product>
@{
	ViewData["Title"] = "Products";
}

<link rel="stylesheet" href="~/css/Views/Inventory/products/ViewProductInventory.css" asp-append-version="true" />

<div class="viewport">
	<div class="content-container">
		<div class="page-header">
			<h2 class="main-title">Products</h2>
		</div>

		<div class="toolbar">
			<form class="search-form" onsubmit="event.preventDefault();">
				<input class="input" type="text" placeholder="Search products..." />
			</form>
			<a class="btn btn-primary" asp-action="AddProductGet" asp-controller="Inventory">+ Add Product</a>
		</div>

		<section class="table-section">
			<table class="table">
				<thead>
					<tr>
						<th>Product</th>
						<th>Description</th>
						<th class="text-right" style="width:150px;">Price</th>
						<th class="text-right" style="width:120px;"># Parts</th>
						<th style="width:200px; text-align:center;">Actions</th>
					</tr>
				</thead>
				<tbody>
					@if (Model == null || !Model.Any())
					{
						<tr>
							<td colspan="5" style="text-align:center; padding: 40px; color: var(--text-muted);">
								No products found.
							</td>
						</tr>
					}
					else
					{
						foreach (var p in Model)
						{
							var partsCount = p.ProductComponents?.Count ?? 0;
							<tr>
								<td>@p.Name</td>
								<td>@p.Description</td>
								<td class="text-right">@p.Price.ToString("C")</td>
								<td class="text-right">@partsCount</td>
								<td>
									<div class="actions">
										<a class="btn btn-secondary btn-sm"
										   asp-controller="Inventory" asp-action="ViewProduct" asp-route-id="@p.Id">View</a>
										<a class="btn btn-primary btn-sm"
										   asp-controller="Inventory" asp-action="EditProduct" asp-route-id="@p.Id">Edit</a>
									</div>
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</section>
	</div>
</div>