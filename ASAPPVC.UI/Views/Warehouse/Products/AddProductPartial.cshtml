@model ASAPPVC.UI.Models.CreateProductVm
@using ASAPPVC.UI.Models
@{
	var parts = (ViewData["Components"] as List<ComponentListVm>) ?? new List<ComponentListVm>();
}

<div class="add-product-partial">
	<style>
		.add-product-partial {
			color: #0b1220;
			font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
		}

			.add-product-partial .card {
				background: #fff;
				border: 1px solid #e5e7eb;
				border-radius: 12px;
				padding: 20px;
			}

			.add-product-partial .grid {
				display: grid;
				gap: 16px;
			}

			.add-product-partial .grid-2 {
				grid-template-columns: 1fr 1fr;
			}

			.add-product-partial .grid-responsive {
				grid-template-columns: 280px 1fr;
			}

		@@media (max-width: 900px) {
			.add-product-partial .grid-responsive {
				grid-template-columns: 1fr;
			}

			.add-product-partial .grid-2 {
				grid-template-columns: 1fr;
			}
		}

		.add-product-partial label {
			font-size: 14px;
			font-weight: 600;
			color: #0b1220;
			margin-bottom: 6px;
			display: inline-block;
		}

		.add-product-partial .input, .add-product-partial select.input, .add-product-partial textarea.input {
			width: 100%;
			height: 42px;
			font-size: 15px;
			border: 1px solid #d1d5db;
			border-radius: 8px;
			padding: 8px 10px;
			outline: none;
			background: #fff;
		}

		.add-product-partial textarea.input {
			height: 96px;
			resize: vertical;
		}

		.add-product-partial .text-danger {
			color: #b91c1c;
			font-size: 12px;
			margin-top: 6px;
		}

		/* Image box (no JS; static placeholder) */
		.add-product-partial .image-box {
			width: 100%;
			max-width: 220px;
			aspect-ratio: 1/1;
			border-radius: 10px;
			border: 1px dashed #cbd5e1;
			display: grid;
			place-items: center;
			overflow: hidden;
			background: #f8fafc;
			color: #64748b;
			font-size: 13px;
			text-align: center;
			padding: 10px;
		}

		/* Parts table (no JS) */
		.add-product-partial .parts-card {
			margin-top: 8px;
		}

		.add-product-partial table {
			width: 100%;
			border-collapse: collapse;
		}

		.add-product-partial thead th {
			text-align: left;
			font-size: 13px;
			font-weight: 700;
			color: #64748b;
			padding: 8px;
			border-bottom: 1px solid #e2e8f0;
		}

		.add-product-partial tbody td {
			padding: 8px;
			border-bottom: 1px solid #f1f5f9;
			vertical-align: middle;
		}

		/* Buttons */
		.add-product-partial .actions {
			display: flex;
			gap: 10px;
			justify-content: flex-end;
			margin-top: 14px;
		}

		.add-product-partial .btn {
			height: 40px;
			padding: 0 18px;
			border-radius: 8px;
			font-weight: 700;
			font-size: 14px;
			border: 1px solid transparent;
			cursor: pointer;
			background: #0ea5e9;
			color: #fff;
		}

			.add-product-partial .btn:hover {
				filter: brightness(0.95);
			}

		.add-product-partial .btn-secondary {
			background: #fff;
			color: #0b1220;
			border-color: #cbd5e1;
		}

		.add-product-partial .btn-ghost {
			background: #f8fafc;
			color: #0b1220;
			border-color: #e2e8f0;
		}
	</style>

	<form asp-controller="Products" asp-action="AddProduct" method="post" enctype="multipart/form-data" class="card">
		@Html.AntiForgeryToken()
		<div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:8px;"></div>

		<div class="grid grid-responsive">
			<div>
				<div class="image-box">
					<div>
						<div style="font-weight:700;">Product Image</div>
						<div style="margin-top:6px;">(Preview shows after upload on submit)</div>
					</div>
				</div>
				<div style="margin-top:10px;">
					<input name="ImageFile" type="file" accept="image/*" class="input" />
				</div>
			</div>

			<!-- Right: Fields -->
			<div class="grid grid-2">
				<div>
					<label asp-for="Name"></label>
					<input asp-for="Name" class="input" placeholder="Enter product name" />
					<span asp-validation-for="Name" class="text-danger"></span>
				</div>
				<div>
					<label asp-for="Price"></label>
					<input asp-for="Price" class="input" step="0.01" placeholder="e.g. 299.99" />
					<span asp-validation-for="Price" class="text-danger"></span>
				</div>
				<div style="grid-column: 1 / -1;">
					<label asp-for="Description"></label>
					<textarea asp-for="Description" class="input" placeholder="Short description..."></textarea>
					<span asp-validation-for="Description" class="text-danger"></span>
				</div>

				<div class="parts-card" style="grid-column: 1 / -1;">
					<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:6px;">
						<h3 style="margin:0; font-size:18px;">Parts in this Product</h3>
						<small style="color:#64748b;">(Add more rows server-side on postback, if needed)</small>
					</div>

					<table>
						<thead>
							<tr>
								<th>Part</th>
								<th style="width:140px;">Quantity</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td>
									<select name="Components[0].ComponentId" class="input">
										<option value="">-- Select part --</option>
										@foreach (var p in parts)
										{
											<option value="@p.Id">@p.Name</option>
										}
									</select>
								</td>
								<td>
									<input class="input" type="number" name="Components[0].QuantityRequired" value="1" min="0.01" step="0.01" />
								</td>
							</tr>
						</tbody>
					</table>
				</div>

				<div class="actions" style="grid-column: 1 / -1;">
					<button type="reset" class="btn btn-secondary">Reset</button>
					<button type="submit" name="SubmitAction" value="SaveAndNext" class="btn btn-ghost" title="Save and immediately start a new product">
						Save &amp; Add Next
					</button>
					<button type="submit" name="SubmitAction" value="Save" class="btn">
						Save Product
					</button>
				</div>
			</div>
		</div>
	</form>
</div></div>