@using System.Linq
@model IEnumerable<ASAPPVC.UI.Models.Component>

@{
	ViewData["Title"] = "Inventory";
}

<link rel="stylesheet" href="~/css/Views/Inventory/components/ViewComponentInventory.css" asp-append-version="true" />


<div class="viewport">
	<div class="content-container">
		<div class="page-header">
			<h2 class="main-title">Components</h2>
		</div>

		<div class="toolbar">
			<form class="search-form" asp-controller="Inventory" asp-action="ViewComponentInventory" method="get">
				<input class="input" type="text" name="q" placeholder="Search by component name or location..." value="@Context.Request.Query["q"]" />
				<button type="submit" class="btn btn-secondary">Search</button>
			</form>
			<a class="btn btn-primary" asp-controller="Inventory" asp-action="AddComponent">+ Add New Component</a>
		</div>

		<section class="table-section">
			<table class="table">
				<thead>
					<tr>
						<th style="width:110px;">Code</th>
						<th>Component Name</th>
						<th>Location</th>
						<th>Unit Price</th>
						<th>Stock</th>
						<th style="width:200px; text-align:center;">Actions</th>
					</tr>
				</thead>
				<tbody>
					@if (Model != null && Model.Any())
					{
						foreach (var p in Model)
						{
							<tr>
								<td>@p.ComponentCode</td>
								<td>@p.Name</td>
								<td>@p.StorageLocation</td>
								<td>@($"R {p.UnitCost:0.00}")</td>
								<td>@p.CurrentAmount</td>
								<td>
									<div class="actions">
										<a class="btn btn-secondary btn-sm"
										   asp-controller="Inventory" asp-action="ViewComponent" asp-route-id="@p.Id">View</a>
										<a class="btn btn-primary btn-sm"
										   asp-controller="Inventory" asp-action="AddComponent" asp-route-id="@p.Id">Edit</a>
									</div>
								</td>
							</tr>
						}
					}
					else
					{
						<tr>
							<td colspan="6" style="text-align:center; padding: 40px; color: var(--text-muted);">
								No components found.
							</td>
						</tr>
					}
				</tbody>
			</table>
		</section>
	</div>
</div>