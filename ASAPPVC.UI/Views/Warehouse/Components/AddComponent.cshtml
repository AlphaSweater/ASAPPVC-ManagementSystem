@model global::ASAPPVC.UI.Models.CreateComponentVm
@{
	ViewData["Title"] = "Add New Component";
	ViewData["ShowBackPageName"] = true;
}

@section Styles {
	<link rel="stylesheet" href="~/css/views/warehouse/components/AddComponent.css" asp-append-version="true" />
}

<div class="page">
	@await Html.PartialAsync("_BackButton")

	<!-- Stronger glass so it stands apart from the blue bg -->
	<div class="card glass glass card--page" role="region" aria-labelledby="page-title">
		<header class="card__header">
			<div>
				<h1 id="page-title" class="card__title">@ViewData["Title"]</h1>
				<p class="card__subtitle">Capture a new stock component with image, cost and storage details.</p>
			</div>

			<div class="card__actions">
				<a asp-controller="Components" asp-action="Index" class="btn btn-ghost">
					<span aria-hidden="true">🏷️</span> Components
				</a>
			</div>
		</header>

		<div class="validation-summary" asp-validation-summary="ModelOnly" aria-live="polite"></div>

		<form id="addComponentForm"
			  asp-controller="Components"
			  asp-action="AddComponent"
			  method="post"
			  enctype="multipart/form-data"
			  novalidate>
			@Html.AntiForgeryToken()

			<!-- 2-column body (image left, fields right) -->
			<div class="fx-row fx-nowrap fx-gap-lg card__body">
				<!-- LEFT: image pane (fixed, compact) -->
				<section class="pane-media" aria-labelledby="img-label">
					<h2 id="img-label" class="sr-only">Component Image</h2>

					<label for="imageFile" class="dropzone" tabindex="0" id="dropzone"
						   aria-describedby="drop-hint" aria-label="Upload image by clicking or dropping a file">
						<img id="previewImg" src="~/Assets/Images/placeholder.png" alt="Image preview" />
						<div class="dz-overlay">
							<div class="dz-icon" aria-hidden="true">📷</div>
							<div class="dz-text">
								<strong>Drop an image</strong> or <span class="link">choose a file</span>
								<div id="drop-hint" class="dz-hint">PNG, JPG, WEBP — up to ~5MB</div>
							</div>
						</div>
					</label>

					<input id="imageFile" asp-for="Image" type="file" accept="image/*" class="file-input" />
					<span asp-validation-for="Image" class="field-error"></span>

					<button type="button" class="btn btn-ghost w-100" onclick="document.getElementById('imageFile').click();">
						Choose Image
					</button>
				</section>

				<!-- RIGHT: fields pane -->
				<section class="pane-fields">
					<div class="fields-grid">
						<div class="field half">
							<label asp-for="Name" class="label"></label>
							<input asp-for="Name" class="input" placeholder="e.g. Resistor 10k Ohm" autocomplete="off" autofocus />
							<span asp-validation-for="Name" class="field-error"></span>
						</div>

						<div class="field half">
							<label asp-for="StorageLocation" class="label"></label>
							<input asp-for="StorageLocation" class="input" placeholder="e.g. Bin A-01" autocomplete="off" />
							<span asp-validation-for="StorageLocation" class="field-error"></span>
						</div>

						<div class="field half">
							<label asp-for="UnitCost" class="label"></label>
							<div class="input-affix">
								<span class="affix" aria-hidden="true">R</span>
								<input asp-for="UnitCost" class="input" step="0.01" value="" inputmode="decimal" placeholder="15.50" />
							</div>
							<span asp-validation-for="UnitCost" class="field-error"></span>
						</div>

						<div class="field half">
							<label asp-for="CurrentAmount" class="label"></label>
							<input asp-for="CurrentAmount" class="input" type="number" min="0" placeholder="e.g. 100" />
							<span asp-validation-for="CurrentAmount" class="field-error"></span>
						</div>

						<div class="field full">
							<label asp-for="Unit" class="label"></label>
							<select asp-for="Unit" class="input" asp-items="Html.GetEnumSelectList<global::ASAPPVC.UI.Models.Enums.Unit>()"></select>
							<span asp-validation-for="Unit" class="field-error"></span>
						</div>
					</div>

					<div class="form-actions">
						<button type="submit" class="btn btn-primary">Save Component</button>
						<button type="reset" class="btn btn-ghost">Reset</button>
					</div>
				</section>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	<script>
		(() => {
			const fileInput = document.getElementById('imageFile');
			const previewImg = document.getElementById('previewImg');
			const dropzone = document.getElementById('dropzone');

			function previewFile(file) {
				if (!file || !file.type?.startsWith('image/')) return;
				const reader = new FileReader();
				reader.onload = e => { previewImg.src = e.target.result; };
				reader.readAsDataURL(file);
			}

			fileInput.addEventListener('change', () => {
				const f = fileInput.files?.[0];
				previewFile(f);
			});

			['dragenter', 'dragover'].forEach(evt =>
				dropzone.addEventListener(evt, e => {
					e.preventDefault(); e.stopPropagation();
					dropzone.classList.add('is-dragover');
				})
			);
			['dragleave', 'drop'].forEach(evt =>
				dropzone.addEventListener(evt, e => {
					e.preventDefault(); e.stopPropagation();
					dropzone.classList.remove('is-dragover');
				})
			);
			dropzone.addEventListener('drop', e => {
				const file = e.dataTransfer?.files?.[0];
				if (file) {
					fileInput.files = e.dataTransfer.files;
					previewFile(file);
				}
			});

			dropzone.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					fileInput.click();
				}
			});
		})();
	</script>
}