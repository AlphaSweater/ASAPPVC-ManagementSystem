@model global::ASAPPVC.App.Models.ComponentDetailVm
@{
	ViewData["Title"] = "View Component";
	var vm = Model;

	// Determine the image source, using a placeholder if no image exists.
	var imgSrc = (vm != null && vm.HasImage && !string.IsNullOrWhiteSpace(vm.ImageUrl))
		? vm.ImageUrl
		: "/Assets/Images/placeholder.png";
}

@section Styles {
	<link rel="stylesheet" href="~/css/views/warehouse/components/ViewComponent.css" asp-append-version="true" />
}

<div class="viewport">
	<div class="view-container">
		<div class="header-section">
			@{ ViewData["BackText"] = "Back"; }
			@await Html.PartialAsync("_BackButton")
			<h2 class="main-title">@vm?.Name</h2>
		</div>

		<div class="details-layout-grid">
			<!-- Image Column -->
			<div class="image-col">
				<div class="image-box">
					<img src="@imgSrc" alt="Component Image" />
				</div>
			</div>

			<!-- Details Column -->
			<div class="info-grid">
				<div class="info-pair">
					<div class="label">Storage Location</div>
					<div class="value">@vm?.StorageLocation</div>
				</div>
				<div class="info-pair">
					<div class="label">Current Stock</div>
					<div class="value">@vm?.CurrentAmount</div>
				</div>
				<div class="info-pair">
					<div class="label">Cost Per Unit</div>
					<div class="value">@(vm != null ? vm.UnitCost.ToString("C") : string.Empty)</div>
				</div>
				<div class="info-pair">
					<div class="label">Total Stock Value</div>
					<div class="value">@(vm != null ? (vm.UnitCost * vm.CurrentAmount).ToString("C") : string.Empty)</div>
				</div>
			</div>
		</div>

		<!-- Footer Actions -->
		<div class="actions">
			<a class="btn btn-primary" asp-area="Warehouse" asp-controller="Components" asp-action="AddComponent" asp-route-id="@vm?.Id">Edit Component</a>
		</div>
	</div>
</div>