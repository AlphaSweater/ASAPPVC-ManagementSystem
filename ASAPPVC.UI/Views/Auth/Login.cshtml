@{
    ViewData["Title"] = "Login";
}

<style>
    /* ---------- Page Background Gradient ---------- */
    html, body {
        height: 100%;
        margin: 0;
        font-family: "Montserrat", system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
        background: linear-gradient(135deg, #215c99 0%, #252d6a 100%);
        color: #000; 
    }

    .viewport {
        min-height: 100%;
        display: grid;
        place-items: center;
        padding: 20px;
    }

    /* ---------- Card Container ---------- */
    .card {
        width: min(350px, 94vw);
        border-radius: 12px;
        background: #f3f3f3;
        padding: 30px 24px;
        text-align: center;
        border: 2px solid #c62929;
        box-shadow: 0 16px 40px rgba(0,0,0,.35);
    }

    /* ---------- Logo & Brand ---------- */
    .logo {
        width: 100px;
        height: 100px;
        object-fit: contain;
        margin-bottom: 10px;
    }

    .brand {
        font-size: 25px;
        font-weight: 500;
        margin-bottom: 30px;
        color: #333;
    }

    .logo-wrap {
        display: flex;
        justify-content: center;
        margin-bottom: 10px;
    }

    /* ---------- Field Labels ---------- */
    .field-label {
        text-align: left;
        font-size: 12px;
        font-weight: 600;
        color: #555;
        margin-top: 20px;
    }

        .field-label.first {
            margin-top: 35px;
        }

    /* ---------- Inputs ---------- */
    .field {
        position: relative;
        margin-top: 6px;
    }

        .field .icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            opacity: .6;
        }

    .input {
        width: 100%;
        height: 40px;
        font-size: 14px;
        font-weight: 500;
        color: #333;
        background: #fff;
        border: 1px solid rgba(198, 41, 41, 0.5);
        border-radius: 8px;
        padding-left: 36px;
        outline: none;
    }

        .input:focus {
            border-color: rgba(198, 41, 41, 1);
            box-shadow: 0 0 0 3px rgba(198,41,41,0.3);
        }

    /* ---------- Button ---------- */
    .actions {
        margin-top: 40px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    .btn-primary {
        width: 150px;
        height: 40px;
        border: none;
        border-radius: 20px;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        background: linear-gradient(135deg, #ef4723, #c62929);
        box-shadow: 0 6px 18px rgba(0,0,0,.35);
        transition: all .2s ease;
    }

        .btn-primary:hover {
            filter: brightness(1.1);
        }

    /* ---------- Forgot Password ---------- */
    .hint {
        margin-top: 10px;
        font-size: 12px;
        font-weight: 500;
        color: #555;
    }

        .hint a {
            color: #c62929;
            text-decoration: none;
            margin-left: 6px;
        }

            .hint a:hover {
                text-decoration: underline;
            }

    /* ---------- Validation Messages ---------- */
    .text-danger {
        color: #c62929;
        font-size: 12px;
        margin-top: 4px;
        display: block;
        text-align: left;
    }
</style>

<div class="viewport">
    <div class="card">
        <!-- Logo + Brand -->
        <div class="logo-wrap">
            <img class="logo" src="/Assets/Images/Logos/asap-pvc-logo.png" alt="A.S.A.P PVC" />
        </div>

        <div class="brand">A.S.A.P PVC</div>

        <!-- Login Form -->
        <form asp-controller="Auth" asp-action="Login" method="post" novalidate>
            @Html.AntiForgeryToken()

            <!-- Username -->
            <div class="field-label first">Username</div>
            <div class="field">
                <span class="icon">👤</span>
                <input class="input" type="text" name="Username" placeholder="Enter username" autocomplete="username" />
            </div>
            @if (ViewData.ModelState["Username"]?.Errors.Count > 0)
            {
                <span class="text-danger">
                    @ViewData.ModelState["Username"]?.Errors[0]?.ErrorMessage
                </span>
            }

            <!-- Password -->
            <div class="field-label">Password</div>
            <div class="field">
                <span class="icon">🔑</span>
                <input class="input" type="password" name="Password" placeholder="Enter password" autocomplete="current-password" />
            </div>
            @if (ViewData.ModelState["Password"]?.Errors.Count > 0)
            {
                <span class="text-danger">
                    @ViewData.ModelState["Password"]?.Errors[0]?.ErrorMessage
                </span>
            }

            <!-- Actions -->
            <div class="actions">
                <button type="submit" class="btn-primary">LOG IN</button>
                <div class="hint">
                    Forgot Password?
                    <a asp-controller="Auth" asp-action="ForgotPassword">Reset</a>
                </div>
            </div>
        </form>
    </div>
</div>