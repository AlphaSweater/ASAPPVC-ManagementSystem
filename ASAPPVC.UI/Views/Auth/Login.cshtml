@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - A.S.A.P PVC</title>

    <style>
        :root {
            --primary-red: #d62828;
            --primary-blue: #1a4e95;
            --hover-red: #e03a3a;
            --text-color: #ffffff;
            --placeholder-color: rgba(255, 255, 255, 0.7);
        }

        /* --- Universal Reset for Better Layout Control --- */
        * {
            box-sizing: border-box;
        }

        /* ---------- Base & Background ---------- */
        html, body {
            height: 100%;
            margin: 0;
            font-family: "Segoe UI", system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
            position: relative;
            /* The robust centering solution */
            display: grid;
            place-items: center;
        }

        body {
            background-color: #1c3d72; /* Fallback color */
            background-image: linear-gradient(120deg, var(--primary-red) 0%, var(--primary-blue) 100%);
        }

            /* ---------- Decorative Background Shapes ---------- */
            body::before, body::after {
                content: '';
                position: absolute;
                border-radius: 50%;
                filter: blur(150px);
                opacity: 0.6;
                /* z-index removed from here to fix layering */
            }

            body::before {
                background: var(--primary-red);
                width: 350px;
                height: 350px;
                top: -80px;
                left: -120px;
            }

            body::after {
                background: var(--primary-blue);
                width: 400px;
                height: 400px;
                bottom: -150px;
                right: -180px;
            }

        /* ---------- Glassmorphism Card ---------- */
        .login-card {
            width: min(400px, 95vw);
            /* --- FIX #1: Increased horizontal padding --- */
            padding: 40px 40px;
            text-align: center;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
            /* --- FIX #2: Correct stacking context to prevent gradient glitches --- */
            position: relative;
            z-index: 1;
        }

        /* ---------- Logo & Brand ---------- */
        .logo {
            width: 80px;
            height: 80px;
            object-fit: contain;
            margin-bottom: 10px;
        }

        .brand-name {
            font-size: 28px;
            font-weight: 600;
            color: var(--text-color);
            margin-bottom: 30px;
        }

        /* ---------- Input Fields ---------- */
        .input-group {
            position: relative;
            margin-bottom: 25px;
        }

        .input-field {
            width: 100%;
            height: 50px;
            font-size: 16px;
            font-weight: 500;
            color: var(--text-color);
            background: transparent;
            border: none;
            border-bottom: 1px solid rgba(255, 255, 255, 0.4);
            padding-left: 40px;
            outline: none;
            transition: border-color 0.3s ease;
        }

            .input-field::placeholder {
                color: var(--placeholder-color);
                font-weight: 400;
            }

            .input-field:focus {
                border-bottom-color: var(--text-color);
            }

            /* FIX for Browser Autofill Style Override */
            .input-field:-webkit-autofill,
            .input-field:-webkit-autofill:hover,
            .input-field:-webkit-autofill:focus,
            .input-field:-webkit-autofill:active {
                -webkit-text-fill-color: var(--text-color) !important;
                transition: background-color 5000s ease-in-out 0s;
                background-color: transparent !important;
            }

        .input-group .icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            width: 20px;
            height: 20px;
            fill: var(--placeholder-color);
        }

        /* ---------- Options (Remember Me & Forgot) ---------- */
        .options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: -10px;
            margin-bottom: 30px;
            font-size: 14px;
        }

        .remember-me {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--placeholder-color);
        }

        .options a {
            color: var(--placeholder-color);
            text-decoration: none;
            transition: color 0.3s ease;
        }

            .options a:hover {
                color: var(--text-color);
                text-decoration: underline;
            }

        input[type="checkbox"] {
            accent-color: var(--primary-red);
        }

        /* ---------- Button ---------- */
        .btn-login {
            width: 100%;
            height: 50px;
            border: none;
            border-radius: 10px;
            color: #fff;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            background: var(--primary-red);
            transition: background-color 0.3s ease, transform 0.1s ease;
            margin-bottom: 20px;
        }

            .btn-login:hover {
                background: var(--hover-red);
            }

            .btn-login:active {
                transform: scale(0.98);
            }

        /* ---------- Validation Messages ---------- */
        .text-danger {
            color: #ffcdd2;
            font-size: 14px;
            text-align: left;
            display: block;
            margin-top: 6px;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <img class="logo" src="/Assets/Images/Logos/asap-pvc-logo-dark.png" alt="A.S.A.P PVC" />
        <div class="brand-name">A.S.A.P PVC</div>

        <form asp-controller="Auth" asp-action="Login" method="post" novalidate>
            @Html.AntiForgeryToken()

            <!-- Email -->
            <div class="input-group">
                <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M20,4H4C2.9,4,2.01,4.9,2.01,6L2,18c0,1.1,0.89,2,1.99,2H20c1.1,0,2-0.9,2-2V6C22,4.9,21.1,4,20,4z M20,8l-8,5L4,8V6l8,5 l8-5V8z" /></svg>
                <input class="input-field" type="email" name="Email" placeholder="Enter your email" autocomplete="username" />
            </div>
            @if (ViewData.ModelState["Email"]?.Errors.Count > 0)
            {
                <span class="text-danger">@ViewData.ModelState["Email"]?.Errors[0]?.ErrorMessage</span>
            }

            <!-- Password -->
            <div class="input-group">
                <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M18,8h-1V6c0-2.76-2.24-5-5-5S7,3.24,7,6v2H6c-1.1,0-2,0.9-2,2v10c0,1.1,0.9,2,2,2h12c1.1,0,2-0.9,2-2V10C20,9.1,19.1,8,18,8z M12,17c-1.1,0-2-0.9-2-2s0.9-2,2-2s2,0.9,2,2S13.1,17,12,17z M9,8V6c0-1.65,1.35-3,3-3s3,1.35,3,3v2H9z" /></svg>
                <input class="input-field" type="password" name="Password" placeholder="Enter your password" autocomplete="current-password" />
            </div>
            @if (ViewData.ModelState["Password"]?.Errors.Count > 0)
            {
                <span class="text-danger">@ViewData.ModelState["Password"]?.Errors[0]?.ErrorMessage</span>
            }

            <!-- Options -->
            <div class="options">
                <label class="remember-me">
                    <input type="checkbox" name="RememberMe" /> Remember me
                </label>
                <a asp-controller="Auth" asp-action="ForgotPassword">Forgot Password?</a>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-login">LOG IN</button>

            <!-- General Errors -->
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="text-danger" style="text-align:center;">
                    @foreach (var e in ViewData.ModelState[string.Empty].Errors)
                    {
                        @e.ErrorMessage
                        <br />
                    }
                </div>
            }
        </form>
    </div>
</body>
</html>