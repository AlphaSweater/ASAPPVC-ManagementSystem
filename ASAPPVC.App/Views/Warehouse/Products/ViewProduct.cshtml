@using ASAPPVC.App.Models
@model ProductDetailVm
@{
	ViewData["Title"] = "View Product";
	ProductDetailVm vm = Model!;

	// Determine the image source, using a placeholder if no image exists.
	var imgSrc = (vm != null && vm.HasImage && !string.IsNullOrWhiteSpace(vm.ImageUrl))
		? vm.ImageUrl
		: "/Assets/Images/placeholder.png";
}

@section Styles {
	<link rel="stylesheet" href="~/css/flexy-grids.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/views/warehouse/products/ViewProduct.css" asp-append-version="true" />
}

<div class="page fxg-u-container fxg-u-min-h-20vh">
	@{
		ViewData["BackText"] = "Back";
	}
	@await Html.PartialAsync("_BackButton")

	<div role="region" aria-labelledby="page-title" class="fxg-f-col fxg-u-gap-6">

		<header class="card-header fxg-f-row fxg-f-main-between fxg-f-cross-center fxg-u-p-4 fxg-u-rounded">
			<div>
				<h1 id="page-title" class="card-title">@vm!.ProductName</h1>
				<p class="card-subtitle">Product details and cost breakdown.</p>
			</div>

			<div class="card-actions fxg-f-row fxg-u-gap-4 fxg-f-cross-center">
				<a class="btn btn-ghost" asp-area="Warehouse" asp-controller="Products" asp-action="ManageProducts">🏷️ Products</a>
			</div>
		</header>

		<div class="card-body fxg-f-col fxg-u-gap-6">
			<!-- Row 1: Media + Details Grid -->
			<div class="fxg-f-row fxg-f-nowrap fxg-u-gap-6">
				<section class="media-panel fxg-f-col fxg-f-main-center fxg-f-cross-center fxg-f-grow-1">
					<h2 class="sr-only">Product Image</h2>
					<div class="image-box">
						<img src="@imgSrc" alt="@vm.ProductName Product Image" />
					</div>
				</section>

				<div class="fxg-f-col fxg-f-grow-1 fxg-u-gap-6">
					<section class="section-card fxg-f-col fxg-u-gap-4">
						<h2 class="section-title">Product Information</h2>

						<div class="fxg-f-row fxg-f-wrap fxg-u-gap-4">
							<div class="info-pair" style="flex: 1 1 240px; min-width: 220px;">
								<div class="label">Product Name</div>
								<div class="value">@vm.ProductName</div>
							</div>
							<div class="info-pair" style="flex: 1 1 240px; min-width: 220px;">
								<div class="label">Selling Price</div>
								<div class="value price">@vm.SellingPrice.ToString("C")</div>
							</div>
						</div>
					</section>

					<section class="section-card fxg-f-col fxg-u-gap-4">
						<h2 class="section-title">Classification</h2>

						<div class="fxg-f-row fxg-f-wrap fxg-u-gap-4">
							<div class="info-pair" style="flex: 1 1 240px; min-width: 220px;">
								<div class="label">Category</div>
								<div class="value">@vm.Category</div>
							</div>
							<div class="info-pair" style="flex: 1 1 240px; min-width: 220px;">
								<div class="label">Material Type</div>
								<div class="value">@vm.MaterialType</div>
							</div>
						</div>

						<div class="fxg-f-row fxg-f-wrap fxg-u-gap-4">
							<div class="info-pair" style="flex: 1 1 240px; min-width: 220px;">
								<div class="label">Colour</div>
								<div class="value">@vm.ColourOption</div>
							</div>
						</div>
					</section>
				</div>
			</div>

			<!-- Row 2: Description -->
			@if (!string.IsNullOrEmpty(vm.Description))
			{
				<section class="section-card fxg-f-col fxg-u-gap-4" style="flex: 1 1 100%; min-width: 320px;">
					<h2 class="section-title">Description</h2>

					<div class="info-pair">
						<div class="value">@vm.Description</div>
					</div>
				</section>
			}

			<!-- Row 3: Components Section -->
			<section class="section-card fxg-f-col fxg-u-gap-4" style="flex: 1 1 100%; min-width: 320px;">
				<h2 class="section-title">Components in this Product</h2>

				<div class="components-table-wrapper">
					<table class="components-table">
						<thead>
							<tr>
								<th>Component Code</th>
								<th>Component Name</th>
								<th class="align-right" style="width:120px;">Quantity</th>
								<th class="align-right" style="width:140px;">Unit Price</th>
								<th class="align-right" style="width:140px;">Subtotal</th>
							</tr>
						</thead>
						<tbody>
							@if (vm.ProductComponents != null && vm.ProductComponents.Any())
							{
								decimal grandTotal = 0;
								foreach (var line in vm.ProductComponents)
								{
									var unitCost = line.UnitCost;
									var subtotal = unitCost * line.RequiredQuantity;
									grandTotal += subtotal;
									<tr>
										<td>@line.ComponentCode</td>
										<td>@line.ComponentName</td>
										<td class="align-right">@line.ShortFormattedQuantity</td>
										<td class="align-right">@unitCost.ToString("C")</td>
										<td class="align-right">@subtotal.ToString("C")</td>
									</tr>
								}
								<tr class="grand-total-row">
									<td colspan="4" class="align-right">Total Cost of Components:</td>
									<td class="align-right grand-total">@grandTotal.ToString("C")</td>
								</tr>
							}
							else
							{
								<tr>
									<td colspan="5" style="text-align:center; padding:24px; color: var(--text-muted);">
										No components are linked to this product.
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>

			<!-- Actions -->
			<div class="form-actions fxg-f-row fxg-f-main-end fxg-u-gap-4">
				<a class="btn btn-primary"
				   asp-area="Warehouse"
				   asp-controller="Products"
				   asp-action="EditByCode"
				   asp-route-code="@vm.ProductCode">Edit Product</a>
			</div>
		</div>
	</div>
</div>