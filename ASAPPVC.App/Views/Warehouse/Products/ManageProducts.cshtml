@using ASAPPVC.App.ViewModels.Warehouse
@model ManageProductsVm
@{
	ViewData["Title"] = "Manage Products";
}

@section Styles {
	<link rel="stylesheet" href="~/css/fancy-tables.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/views/warehouse/products/ManageProducts.css" asp-append-version="true" />
}

<div class="page">
	<div role="region" aria-labelledby="page-title">
		<header class="card-header">
			<div>
				<h1 id="page-title" class="card-title">@ViewData["Title"]</h1>
				<p class="card-subtitle">Browse, search and manage products in your catalog.</p>
			</div>
			<div class="card-actions">
				<a class="btn btn-ghost"
				   asp-area="Warehouse"
				   asp-controller="Products"
				   asp-action="AddNew">+ Add Product</a>
			</div>
		</header>

		<div class="card-body">
			<section class="fields-panel full-width">
				<!-- Search -->
				<form class="search-form"
					  asp-area="Warehouse"
					  asp-controller="Products"
					  asp-action="Search"
					  method="get" role="search" aria-label="Search products">
					<input class="input"
						   type="text"
						   name="term"
						   placeholder="Search products by name or code..."
						   value="@Model.SearchQuery"
						   aria-label="Search query" />
					<button type="submit" class="btn btn-ghost">Search</button>
				</form>

				<!-- Products table -->
				<section class="table-section">
					<div class="fancy-wrap">
						<table class="fancy-table fancy-table--zebra table-products">
							<caption class="sr-only">Products list with image, code, name, description, price and actions</caption>

							<colgroup>
								<col class="ft-col ft-col--img" />
								<col class="ft-col ft-col--code" />
								<col class="ft-col ft-col--name" />
								<col class="ft-col ft-col--desc" />
								<col class="ft-col ft-col--price" />
								<col class="ft-col ft-col--actions" />
							</colgroup>

							<thead>
								<tr>
									<th scope="col">IMG</th>
									<th scope="col" class="ft-left">Product Code</th>
									<th scope="col" class="ft-left">Product</th>
									<th scope="col" class="ft-left">Description</th>
									<th scope="col" class="ft-right">Price</th>
									<th scope="col" class="ft-actions">Actions</th>
								</tr>
							</thead>

							<tbody>
								@if (Model is { HasProducts: true })
								{
									foreach (var product in Model.Products)
									{
										<tr>
											<!-- Image -->
											<td class="ft-media">
												@if (product.HasImage && !string.IsNullOrWhiteSpace(product.ThumbUrl))
												{
													<img src="@product.ThumbUrl"
														 class="ft-media__img"
														 loading="lazy"
														 alt=""
														 width="52" height="52" />
												}
												else
												{
													<div class="ft-media__placeholder" aria-hidden="true">🧩</div>
												}
											</td>

											<!-- Code (fixed, no wrap) -->
											<td class="ft-code" title="@product.ProductCode">
												<div class="ft-code__text"> 
													<span>@product.ProductCode</span>
													<button type="button"
															class="ft-code__copy"
															data-copy="@product.ProductCode"
															aria-label="Copy product code">
														<lucideIcon class="icon" name="copy" size="16" stroke-width="1.75" />
													</button>
												</div>
											</td>


											<!-- Name (2-line clamp) -->
											<td class="ft-name" title="@product.ProductName">
												<span class="ft-clip ft-clip--2">@product.ProductName</span>
											</td>

											<!-- Description (3-line clamp on desktop) -->
											<td class="ft-desc" title="@product.Description">
												<span class="ft-clip ft-clip--3">@product.Description</span>
											</td>

											<!-- Price (fixed width, no wrap) -->
											<td class="ft-money">@product.DisplayPrice</td>

											<!-- Actions -->
											<td class="ft-actions">
												<div class="actions">
													<a class="btn btn-secondary btn-sm"
													   asp-area="Warehouse"
													   asp-controller="Products"
													   asp-action="DetailsByCode"
													   asp-route-code="@product.ProductCode"
													   aria-label="View @product.ProductName">
														View
													</a>
													<a class="btn btn-primary btn-sm"
													   asp-area="Warehouse"
													   asp-controller="Products"
													   asp-action="EditByCode"
													   asp-route-code="@product.ProductCode"
													   aria-label="Edit @product.ProductName">
														Edit
													</a>
												</div>
											</td>
										</tr>
									}
								}
								else
								{
									<tr>
										<td colspan="6" class="ft-center" role="status"
											style="padding:40px; color:var(--text-muted);">
											No products found.
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</section>
			</section>
		</div>
	</div>
</div>
