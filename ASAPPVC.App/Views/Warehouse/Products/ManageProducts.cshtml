@using ASAPPVC.App.ViewModels.Warehouse
@model ManageProductsVm
@{
	ViewData["Title"] = "Products";
}

@section Styles {
	<link rel="stylesheet" href="~/css/fancy-tables.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/views/warehouse/products/ManageProducts.css" asp-append-version="true" />
}

<div class="page">
	<div role="region" aria-labelledby="page-title">
		<header class="card-header">
			<div>
				<h1 id="page-title" class="card-title">@ViewData["Title"]</h1>
				<p class="card-subtitle">Browse, search and manage products in your catalog.</p>
			</div>
			<div class="card-actions">
				<a class="btn btn-ghost" asp-area="Warehouse" asp-controller="Products" asp-action="AddNew">+ Add Product</a>
			</div>
		</header>

		<div class="card-body">
			<section class="fields-panel full-width">
				<form class="search-form"
					  asp-area="Warehouse"
					  asp-controller="Products"
					  asp-action="Search"
					  method="get">
					<input class="input" type="text" name="term" placeholder="Search products by name or code..." value="@Model.SearchQuery" />
					<button type="submit" class="btn btn-ghost">Search</button>
				</form>

				<section class="table-section">
					<div class="fancy-wrap">
						<table class="fancy-table fancy-table--zebra">
							<thead>
								<tr>
									<th>IMG</th>
									<th class="ft-left ft-shrink">Product Code</th>
									<th class="ft-left ft-shrink">Product</th>
									<th class="ft-left ft-grow">Description</th>
									<th class="ft-right ft-shrink">Price</th>
									<th class="ft-actions ft-shrink">Actions</th>
								</tr>
							</thead>
							<tbody>
								@if (Model is { HasProducts: true })
								{
									foreach (var product in Model.Products)
									{
										<tr>
											<td class="ft-media ft-shrink">
												@if (product.HasImage && !string.IsNullOrWhiteSpace(product.ThumbUrl))
												{
													<img src="@product.ThumbUrl" class="ft-media__img" />
												}
												else
												{
													<div class="ft-media__placeholder" aria-hidden="true">🧩</div>
												}
											</td>
											<td class="ft-code ft-shrink">@product.ProductCode</td>
											<td class="ft-name ft-shrink ">@product.ProductName</td>
											<td class="ft-left ft-grow">@product.Description</td>
											<td class="ft-money ft-shrink">@product.DisplayPrice</td>
											<td class="ft-actions ft-shrink">
												<div class="actions">
													<a class="btn btn-secondary btn-sm"
													   asp-area="Warehouse"
													   asp-controller="Products"
													   asp-action="DetailsById"
													   asp-route-id="@product.Id">View</a>
													<a class="btn btn-primary btn-sm"
													   asp-area="Warehouse"
													   asp-controller="Products"
													   asp-action="EditById"
													   asp-route-id="@product.Id">Edit</a>
												</div>
											</td>
										</tr>
									}
								}
								else
								{
									<tr>
										<td colspan="6" class="ft-center" style="padding:40px; color:var(--text-muted);">No products found.</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</section>
			</section>
		</div>
	</div>
</div>