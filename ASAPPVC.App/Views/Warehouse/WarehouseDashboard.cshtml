@model ASAPPVC.App.ViewModels.Warehouse.WarehouseDashVm
@{
    ViewData["Title"] = "Warehouse • Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/views/shared/FormCard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/views/warehouse/WarehouseDashboard.css" asp-append-version="true" />
}

<div class="page">
    <div role="region" aria-labelledby="page-title">
        <header class="card-header">
            <div>
                <h1 id="page-title" class="card-title">Warehouse Dashboard</h1>
                <p class="card-subtitle">Quick actions and key stats</p>
            </div>
        </header>

        <div class="card-body">
            <section class="fields-panel" style="width:100%">
                <!-- KPIs -->
                <section class="kpis-grid" aria-label="Key statistics">
                    <div class="kpi-card">
                        <div class="kpi-label">Products</div>
                        <div class="kpi-value">@Model.ProductCount</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-label">Components</div>
                        <div class="kpi-value">@Model.ComponentCount</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-label">Open Orders</div>
                        <div class="kpi-value">@Model.OpenOrdersCount</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-label">Low Stock</div>
                        <div class="kpi-value">@Model.LowStockCount</div>
                    </div>
                </section>

                <!-- Actions -->
                <section class="actions-grid">
                    <a class="action-card" asp-area="Warehouse" asp-controller="Products" asp-action="Index">
                        <div class="icon">📦</div>
                        <div class="text">
                            <h2>Manage Products</h2>
                            <p>Browse, edit, and view product catalog.</p>
                        </div>
                        <span class="btn btn-primary">Open</span>
                    </a>

                    <a class="action-card" asp-area="Warehouse" asp-controller="Components" asp-action="Index">
                        <div class="icon">🏷️</div>
                        <div class="text">
                            <h2>Manage Components</h2>
                            <p>Track inventory Components and locations.</p>
                        </div>
                        <span class="btn btn-primary">Open</span>
                    </a>

                    <a class="action-card" asp-area="Warehouse" asp-controller="Products" asp-action="AddNew">
                        <div class="icon">➕</div>
                        <div class="text">
                            <h2>Add Product</h2>
                            <p>Create a new product and link components.</p>
                        </div>
                        <span class="btn btn-accent">Create</span>
                    </a>

                    <a class="action-card" asp-area="Warehouse" asp-controller="Components" asp-action="AddNew">
                        <div class="icon">➕</div>
                        <div class="text">
                            <h2>Add Component</h2>
                            <p>Capture a new inventory component.</p>
                        </div>
                        <span class="btn btn-accent">Create</span>
                    </a>

                    <a class="action-card" asp-area="" asp-controller="Orders" asp-action="Index">
                        <div class="icon">🗂️</div>
                        <div class="text">
                            <h2>View Orders</h2>
                            <p>See all orders and their status.</p>
                        </div>
                        <span class="btn btn-primary">Open</span>
                    </a>

                    <a class="action-card" asp-area="" asp-controller="Orders" asp-action="AddNew">
                        <div class="icon">🧾</div>
                        <div class="text">
                            <h2>Create Order</h2>
                            <p>Place a new customer order.</p>
                        </div>
                        <span class="btn btn-accent">Create</span>
                    </a>
                </section>
            </section>
        </div>
    </div>
</div>