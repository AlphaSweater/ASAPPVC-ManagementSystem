@using System.Linq
@model ASAPPVC.App.ViewModels.Warehouse.ManageComponentsVm

@{
	ViewData["Title"] = "Manage Components";
}

@section Styles {
	<link rel="stylesheet" href="~/css/views/shared/fancy-tables.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/views/shared/FormCard.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/views/warehouse/components/ManageComponents.css" asp-append-version="true" />
}

<div class="page">
	<div role="region" aria-labelledby="page-title">
		<header class="card-header">
			<div>
				<h1 id="page-title" class="card-title">Components</h1>
				<p class="card-subtitle">Manage inventory components and stock levels.</p>
			</div>

			<div class="card-actions">
				<a class="btn btn-ghost"
				   asp-area="Warehouse"
				   asp-controller="Components"
				   asp-action="AddNew">
					+ Add New Component
				</a>
			</div>
		</header>

		<div class="card-body">
			<section class="fields-panel full-width">
				<form class="search-form"
					  asp-area="Warehouse"
					  asp-controller="Components"
					  asp-action="Search"
					  method="get">
					<input class="input"
						   type="text"
						   name="term"
						   placeholder="Search by component name or location..."
						   value="@Model.SearchQuery" />
					<button type="submit" class="btn btn-ghost">Search</button>
				</form>

				<section class="table-section">
					<div class="fancy-wrap">
						<table class="fancy-table">
							<thead>
								<tr>
									<th></th>
									<th scope="col" class="ft-left ft-shrink">Code</th>
									<th scope="col" class="ft-left ft-grow">Component</th>
									<th scope="col" class="ft-center ft-shrink">Location</th>
									<th scope="col" class="ft-number ft-shrink">Current Stock</th>
									<th scope="col" class="ft-money ft-shrink">Unit Cost</th>
									<th scope="col" class="ft-actions ft-shrink">Actions</th>
								</tr>
							</thead>

							<tbody>
								@if (Model is { HasComponents: true })
								{
									foreach (var c in Model.Components)
									{
										var stockValue = c.UnitCost * c.QuantityOnHand;
										<tr>

											<td class="ft-media ft-shrink">
												@if (c.HasImage && !string.IsNullOrWhiteSpace(c.ThumbUrl))
												{
													<img src="@c.ThumbUrl" class="ft-media__img" />
												}
												else
												{
													<div class="ft-media__placeholder" aria-hidden="true">🧩</div>
												}
											</td>

											<td class="ft-code ft-shrink">@c.ComponentCode</td>

											<td class="ft-left ft-shrink">@c.ComponentName</td>

											<td class="ft-center ft-shrink">@c.LocationCode</td>

											<td class="ft-number ft-shrink">
												@($"{c.ShortFormattedQuantity}")
											</td>

											<td class="ft-money ft-shrink">@c.DisplayCost</td>

											<td class="ft-actions ft-shrink">
												<div class="actions">
													@if (!string.IsNullOrWhiteSpace(c.ComponentCode))
													{
														<!-- URL: /Warehouse/Components/View/{code} -->
														<a class="btn btn-secondary btn-sm"
														   asp-area="Warehouse"
														   asp-controller="Components"
														   asp-action="DetailsByCode"
														   asp-route-code="@c.ComponentCode">View</a>

														<!-- URL: /Warehouse/Components/Edit/{code} -->
														<a class="btn btn-primary btn-sm"
														   asp-area="Warehouse"
														   asp-controller="Components"
														   asp-action="EditByCode"
														   asp-route-code="@c.ComponentCode">Edit</a>
													}
													else
													{
														<!-- URL: /Warehouse/Components/View/{id} -->
														<a class="btn btn-secondary btn-sm"
														   asp-area="Warehouse"
														   asp-controller="Components"
														   asp-action="DetailsById"
														   asp-route-id="@c.Id">View</a>

														<!-- URL: /Warehouse/Components/Edit/{id} -->
														<a class="btn btn-primary btn-sm"
														   asp-area="Warehouse"
														   asp-controller="Components"
														   asp-action="EditById"
														   asp-route-id="@c.Id">Edit</a>
													}
												</div>
											</td>
										</tr>
									}
								}
								else
								{
									<tr>
										<td colspan="7" class="ft-center">No components found.</td>
									</tr>
								}
							</tbody>
						</table>
					</div>

					@if (Model.TotalCount > Model.PageSize)
					{
						var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
						<nav class="pager" aria-label="Components pagination">
							<a class="pager__btn @(Model.Page <= 1 ? "is-disabled" : null)"
							   asp-area="Warehouse"
							   asp-controller="Components"
							   asp-action="Index"
							   asp-route-page="@(Model.Page - 1)"
							   asp-route-pageSize="@Model.PageSize"
							   asp-route-term="@Model.SearchQuery">Prev</a>

							<span class="pager__status">Page @Model.Page of @totalPages</span>

							<a class="pager__btn @(Model.Page >= totalPages ? "is-disabled" : null)"
							   asp-area="Warehouse"
							   asp-controller="Components"
							   asp-action="Index"
							   asp-route-page="@(Model.Page + 1)"
							   asp-route-pageSize="@Model.PageSize"
							   asp-route-term="@Model.SearchQuery">Next</a>
						</nav>
					}
				</section>
			</section>
		</div>
	</div>
</div>