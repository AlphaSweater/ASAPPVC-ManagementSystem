@using System.Linq
@model ASAPPVC.App.ViewModels.Warehouse.ManageComponentsVm

@{
	ViewData["Title"] = "Manage Components";
}

@section Styles {
	<link rel="stylesheet" href="~/css/fancy-tables.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/views/warehouse/components/ManageComponents.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/copy.css" asp-append-version="true" />
}

<div class="page">
	<div role="region" aria-labelledby="page-title">
		<header class="card-header">
			<div>
				<h1 id="page-title" class="card-title">@ViewData["Title"]</h1>
				<p class="card-subtitle">Manage inventory components and stock levels.</p>
			</div>

			<div class="card-actions">
				<a class="btn btn-ghost"
				 asp-area="Warehouse"
				 asp-controller="Components"
				asp-action="AddNew">
					+ Add Component
				</a>
			</div>
		</header>

		<div class="card-body">
			<section class="fields-panel full-width">
				<form class="search-form"
					 asp-area="Warehouse"
					 asp-controller="Components"
					 asp-action="Search"
					 method="get"
					 role="search"
					 aria-label="Search components">
					<input class="input"
						 type="text"
						 name="term"
						 placeholder="Search by component name or location..."
						 value="@Model.SearchQuery"
						 aria-label="Search query" />
					<button type="submit" class="btn btn-ghost">Search</button>
				</form>

				<section class="table-section">
					<div class="fancy-wrap">
						<table class="fancy-table fancy-table--zebra table-components">
							<caption class="sr-only">Components list with image, code, name, location, stock, cost and actions</caption>

							<colgroup>
								<col class="ft-col ft-col--img" />
								<col class="ft-col ft-col--code" />
								<col class="ft-col ft-col--name" />
								<col class="ft-col ft-col--location" />
								<col class="ft-col ft-col--stock" />
								<col class="ft-col ft-col--cost" />
								<col class="ft-col ft-col--actions" />
							</colgroup>

							<thead>
								<tr>
									<th scope="col">IMG</th>
									<th scope="col" class="ft-left">Component Code</th>
									<th scope="col" class="ft-left">Component</th>
									<th scope="col" class="ft-center">Location</th>
									<th scope="col" class="ft-right">Current Stock</th>
									<th scope="col" class="ft-right">Unit Cost</th>
									<th scope="col" class="ft-actions">Actions</th>
								</tr>
							</thead>

							<tbody>
								@if (Model is { HasComponents: true })
								{
									foreach (var component in Model.Components)
									{
										var stockValue = component.UnitCost * component.QuantityOnHand;
										<tr>
											<!-- Image -->
											<td class="ft-media">
												@if (component.HasImage && !string.IsNullOrWhiteSpace(component.ThumbUrl))
												{
													<img src="@component.ThumbUrl"
													 class="ft-media__img"
													 loading="lazy"
													 alt=""
													 width="52" height="52" />
												}
												else
												{
													<div class="ft-media__placeholder" aria-hidden="true">🧩</div>
												}
											</td>

											<!-- Code (fixed, no wrap) -->
											<td class="ft-code" title="@component.ComponentCode">
												<div class="ft-code__text">
													<span>@component.ComponentCode</span>
													<button type="button"
														class="ft-code__copy"
														data-copy="@component.ComponentCode"
														data-action="copy"
														aria-label="Copy component code">
														<lucideIcon class="icon" name="copy" size="16" stroke-width="1.75" />
														</button>
													</div>
												</td>

											<!-- Name (2-line clamp) -->
											<td class="ft-name" title="@component.ComponentName">
												<span class="ft-clip ft-clip--2">@component.ComponentName</span>
											</td>

											<!-- Location (centered) -->
											<td class="ft-location">@component.LocationCode</td>

											<!-- Stock (right-aligned, tabular nums) -->
											<td class="ft-stock">@($"{component.ShortFormattedQuantity}")</td>

											<!-- Cost (right-aligned, no wrap) -->
											<td class="ft-money">@component.DisplayCost</td>

											<!-- Actions -->
											<td class="ft-actions">
												<div class="actions">
													@if (!string.IsNullOrWhiteSpace(component.ComponentCode))
													{
														<a class="btn btn-secondary btn-sm"
													 asp-area="Warehouse"
													 asp-controller="Components"
													 asp-action="DetailsByCode"
													 asp-route-code="@component.ComponentCode"
													 aria-label="View @component.ComponentName">
														View
														</a>
														<a class="btn btn-primary btn-sm"
													 asp-area="Warehouse"
													 asp-controller="Components"
													 asp-action="EditByCode"
													 asp-route-code="@component.ComponentCode"
													 aria-label="Edit @component.ComponentName">
														Edit
														</a>
													}
													else
													{
														<a class="btn btn-secondary btn-sm"
													 asp-area="Warehouse"
													 asp-controller="Components"
													 asp-action="DetailsById"
													 asp-route-id="@component.Id"
													 aria-label="View @component.ComponentName">
														View
														</a>
														<a class="btn btn-primary btn-sm"
													 asp-area="Warehouse"
													 asp-controller="Components"
													 asp-action="EditById"
													 asp-route-id="@component.Id"
													 aria-label="Edit @component.ComponentName">
														Edit
														</a>
													}
												</div>
											</td>
										</tr>
									}
								}
								else
								{
									<tr>
										<td colspan="7" class="ft-center" role="status"
											style="padding:40px; color:var(--text-muted);">
											No components found.
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>

					@if (Model.TotalCount > Model.PageSize)
					{
						var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
						<nav class="pager" aria-label="Components pagination">
							<a class="pager__btn @(Model.Page <= 1 ? "is-disabled" : null)"
							 asp-area="Warehouse"
							 asp-controller="Components"
							 asp-action="Index"
							   asp-route-page="@(Model.Page - 1)"
							 asp-route-pageSize="@Model.PageSize"
							 asp-route-term="@Model.SearchQuery">Prev</a>

							<span class="pager__status">Page @Model.Page of @totalPages</span>

							<a class="pager__btn @(Model.Page >= totalPages ? "is-disabled" : null)"
							 asp-area="Warehouse"
							 asp-controller="Components"
							 asp-action="Index"
							   asp-route-page="@(Model.Page + 1)"
							 asp-route-pageSize="@Model.PageSize"
							 asp-route-term="@Model.SearchQuery">Next</a>
						</nav>
					}
				</section>
			</section>
		</div>
	</div>
</div>

@section Scripts {
	<script src="~/js/copy.js" asp-append-version="true"></script>
}