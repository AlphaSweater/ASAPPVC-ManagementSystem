@using System.Linq
@model ASAPPVC.App.ViewModels.Warehouse.ManageComponentsVm

@{
	ViewData["Title"] = "Manage Components";
}

@section Styles {
	<link rel="stylesheet" href="~/css/views/shared/fancy-tables.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/views/shared/FormCard.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/views/warehouse/components/ManageComponents.css" asp-append-version="true" />
}

<div class="page">
	@await Html.PartialAsync("_BackButton")

	<div role="region" aria-labelledby="page-title">
		<header class="card-header">
			<div>
				<h1 id="page-title" class="card-title">Components</h1>
				<p class="card-subtitle">Manage inventory components and stock levels.</p>
			</div>

			<div class="card-actions">
				<a class="btn btn-ghost"
				   asp-area="Warehouse"
				   asp-controller="Components"
				   asp-action="AddComponent">
					+ Add New Component
				</a>
			</div>
		</header>

		<div class="card-body">
			<section class="fields-panel full-width">
				<form class="search-form"
					  asp-area="Warehouse"
					  asp-controller="Components"
					  asp-action="Search"
					  method="get">
					<input class="input"
						   type="text"
						   name="term"
						   placeholder="Search by component name or location..."
						   value="@Model.SearchQuery" />
					<button type="submit" class="btn btn-ghost">Search</button>
				</form>

				<section class="table-section">
					<div class="fancy-wrap">
						<table class="fancy-table">
							<thead>
								<tr>
									<th class="ft-center ft-shrink">Component Code</th>
									<th class="ft-left ft-grow">Component Name</th>
									<th class="ft-center ft-shrink">Location</th>
									<th class="ft-number ft-shrink">Current Stock</th>
									<th class="ft-money ft-shrink">Unit Price</th>
									<th class="ft-actions ft-shrink">Actions</th>
								</tr>
							</thead>

							<tbody>
								@if (Model is { HasComponents: true })
								{
									foreach (var component in Model.Components)
									{
										<tr>
											<td class="ft-code ft-shrink">@component.ComponentCode</td>
											<td class="ft-left ft-grow ft-name">@component.Name</td>
											<td class="ft-center ft-shrink">@component.StorageLocation</td>
											<td class="ft-number ft-shrink">@component.CurrentAmount</td>
											<td class="ft-money ft-shrink">@($"R {component.UnitCost:0.00}")</td>
											<td class="ft-actions ft-shrink">
												<div class="actions">
													<a class="btn btn-secondary btn-sm"
													   asp-area="Warehouse"
													   asp-controller="Components"
													   asp-action="ViewComponent"
													   asp-route-id="@component.Id">
														View
													</a>
													<a class="btn btn-primary btn-sm"
													   asp-area="Warehouse"
													   asp-controller="Components"
													   asp-action="AddComponent"
													   asp-route-id="@component.Id">
														Edit
													</a>
												</div>
											</td>
										</tr>
									}
								}
								else
								{
									<tr>
										<td colspan="6" class="ft-center">
											No components found.
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</section>
			</section>
		</div>
	</div>
</div>