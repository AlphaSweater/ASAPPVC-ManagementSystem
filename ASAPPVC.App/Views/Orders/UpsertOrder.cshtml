@using ASAPPVC.App.Models.Enums
@model ASAPPVC.App.Models.OrderFormVm
@{
	var isEdit = Model?.IsEdit == true;
	ViewData["Title"] = isEdit ? "Edit Order" : "Add New Order";
	ViewData["ShowBackPageName"] = true;
}

@section Styles {
	<link rel="stylesheet" href="~/css/flexy-grids.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/fancy-tables.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/Views/Orders/UpsertOrder.css" asp-append-version="true" />
}

<div class="page fxg-u-container fxg-u-min-h-20vh">
	@await Html.PartialAsync("_BackButton")

	<div role="region" aria-labelledby="page-title" class="fxg-f-col fxg-u-gap-6">

		<header class="card-header fxg-f-row fxg-f-main-between fxg-f-cross-center fxg-u-p-4 fxg-u-rounded">
			<div>
				<h1 id="page-title" class="card-title">@ViewData["Title"]</h1>
				<p class="card-subtitle">Create or update a customer order and manage product quantities.</p>
			</div>
			<div class="card-actions fxg-f-row fxg-u-gap-4 fxg-f-cross-center">
				<a asp-action="ViewOrders" class="btn btn-ghost">📦 Orders</a>
			</div>
		</header>

		<form id="upsert-order-form" asp-action="Upsert" method="post" class="fxg-f-col fxg-u-gap-6">
			@Html.AntiForgeryToken()

			@if (isEdit)
			{
				<input asp-for="Id" type="hidden" />
				<input asp-for="OrderCode" type="hidden" />
			}

			<div class="fxg-f-col fxg-u-gap-6">
				<div class="validation-summary" asp-validation-summary="ModelOnly"></div>

				<!-- Row 1: Order Details -->
				<div class="fxg-f-row fxg-u-gap-6">

					<section class="section-card fxg-f-col fxg-u-gap-4 fxg-f-grow-2">
						<h2 class="section-title">Order Details</h2>

						<div class="fxg-f-row fxg-f-wrap fxg-u-gap-4">
							<div class="form-field" style="flex: 2 1 360px; min-width: 260px;">
								<label asp-for="CustomerId" class="label"></label>
								<select asp-for="CustomerId" class="input" required>
									<option value="">-- Choose a customer --</option>
									@foreach (var customer in Model.AvailableCustomers ?? new List<Customer>())
									{
										<option value="@customer.Id">@customer.Name @customer.Surname (@customer.Email)</option>
									}
								</select>
								<span asp-validation-for="CustomerId" class="field-error"></span>
							</div>

							<div class="form-field" style="flex: 1 1 200px; min-width: 180px;">
								<label asp-for="OrderStatus" class="label"></label>
								<select asp-for="OrderStatus" class="input" asp-items="Html.GetEnumSelectList<OrderStatus>()"></select>
								<span asp-validation-for="OrderStatus" class="field-error"></span>
							</div>

							<div class="form-field" style="flex: 1 1 200px; min-width: 180px;">
								<label asp-for="OrderDate" class="label"></label>
								<input asp-for="OrderDate" type="datetime-local" class="input" />
								<span asp-validation-for="OrderDate" class="field-error"></span>
							</div>
						</div>

					</section>

					<!-- Notes (Optional) -->
					<section class="section-card fxg-f-col fxg-u-gap-4 fxg-f-grow-1">
						<h2 class="section-title">Additional Notes (Optional)</h2>
						<div class="form-field">
							<textarea asp-for="Notes" class="input" rows="3" placeholder="Any special instructions or notes for this order…"></textarea>
							<span asp-validation-for="Notes" class="field-error"></span>
						</div>
					</section>
				</div>

				<!-- Row 2: Products Section -->
				<section class="section-card fxg-f-col fxg-u-gap-4">
					<div class="section-head">
						<h2 class="section-title">Products in this Order</h2>

						<!-- Typeahead add box -->
						<div class="product-add-box fxg-f-row fxg-u-gap-3 fxg-f-cross-center">
							<input id="productSearch"
								   class="input"
								   type="text"
								   list="productsList"
								   placeholder="Search product by name or code…"
								   autocomplete="off"
								   style="min-width: 280px;" />
							<datalist id="productsList">
								@foreach (var p in Model.AvailableProducts ?? new List<ProductListVm>())
								{
									var label = !string.IsNullOrWhiteSpace(p.ProductCode)
									? $"{p.ProductCode} — {p.ProductName}"
									: p.ProductName;
									<option value="@label"
											data-id="@p.Id"
											data-price="@p.SellingPrice.ToString("F2")"
											data-code="@p.ProductCode"
											data-name="@p.ProductName"></option>
								}
							</datalist>

							<input id="quantityInput"
								   type="number"
								   class="input qty-input-inline"
								   value="1"
								   min="1"
								   step="1"
								   required
								   inputmode="numeric"
								   aria-label="Quantity"
								   style="width: 100px; text-align: center;" />

							<button type="button" id="addProductBtn" class="btn btn-primary btn-sm">+ Add Product</button>
						</div>
					</div>

					<!-- Products Table -->
					<div class="fancy-wrap">
						<table class="fancy-table" id="productsTable">
							<thead>
								<tr>
									<th class="ft-grow">Product</th>
									<th class="ft-center" style="width:120px;">Quantity</th>
									<th class="ft-money" style="width:140px;">Unit Price</th>
									<th class="ft-money" style="width:140px;">Subtotal</th>
									<th class="ft-center" style="width:80px;"></th>
								</tr>
							</thead>
							<tbody id="productsTbody"></tbody>
							<tfoot>
								<tr>
									<td colspan="3" class="ft-right" style="font-weight: 600;">Grand Total:</td>
									<td class="ft-money grand-total" id="grandTotal">R0.00</td>
									<td></td>
								</tr>
							</tfoot>
						</table>
					</div>
				</section>

				<!-- Form Actions -->
				<div class="form-actions fxg-f-row fxg-f-main-end fxg-u-gap-4">
					<button type="submit" class="btn btn-primary">@(isEdit ? "Save Changes" : "Create Order")</button>
					<button type="reset" class="btn btn-ghost">Reset</button>
				</div>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	<script type="application/json" id="upsert-order-data">
		@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
			available = Model.AvailableProducts ?? new List<ProductListVm>(),
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																