@{
    ViewData["Title"] = "Dashboard";
}

<style>
    :root {
        --primary-red: #d62828;
        --primary-blue: #0d47a1; /* A much deeper, more intense blue */
        --hover-red: #e03a3a;
        --text-light: #ffffff;
        --text-muted: rgba(255, 255, 255, 0.7);
        --accent-orange: #ef4723;
    }

    /* ---------- Base & Background ---------- */
    html, body {
        height: 100%;
        margin: 0;
        font-family: "Segoe UI", system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    }

    /* --- Universal Reset for Better Layout Control --- */
    * {
        box-sizing: border-box;
    }


    /* ===== Header Row ===== */
    .head {
        margin-bottom: 24px;
    }

        .head .crumb {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
            font-size: 1.25rem;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            padding: 10px 16px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

    /* ===== Grid Layout ===== */
    .grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 20px;
    }

    /* ===== Glassmorphism Cards ===== */
    .card {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
        border-radius: 16px;
        padding: 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
        }

        .card h3 {
            margin: 0 0 12px 0;
            font-size: 18px;
            font-weight: 600;
            color: var(--text-light);
            display: flex;
            align-items: center;
            gap: 8px;
        }

    /* ===== KPI Card Specifics --- LAYOUT FIX --- ===== */
    .kpi-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 150px; /* Ensure cards have a consistent height */
    }

    .kpi-header {
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .kpi-header h3 {
            margin: 0;
            font-size: 16px;
            font-weight: 500;
            color: var(--text-muted); /* Muted color for the title */
        }

    .kpi-card .big {
        font-size: 36px;
        font-weight: 700;
        color: var(--text-light);
        text-align: left;
    }

    .kpi-header .icon {
        width: 44px; /* Slightly smaller icon for the header */
        height: 44px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--accent-orange), var(--primary-red));
        display: grid;
        place-items: center;
        color: #fff;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2), inset 0 2px 4px rgba(0,0,0,0.15);
        flex-shrink: 0; /* Prevent icon from shrinking */
    }

        .kpi-header .icon svg {
            width: 24px;
            height: 24px;
            fill: #ffffff;
        }


    /* Grid spanning helpers */
    .span-2 {
        grid-column: span 2;
    }

    .span-3 {
        grid-column: span 3;
    }

    /* ===== Chart Placeholders ===== */
    .chart-box {
        height: 280px;
    }

        .chart-box svg {
            width: 100%;
            height: 100%;
            border-radius: 8px;
        }

    /* ===== Last Transactions List ===== */
    .list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-height: 280px;
        overflow-y: hidden;
    }

    .tx {
        display: grid;
        grid-template-columns: 36px 1fr auto;
        align-items: center;
        gap: 12px;
        padding: 12px;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: transparent;
        transition: background-color 0.2s ease;
    }

        .tx:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        .tx .ico {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: linear-gradient(135deg, var(--accent-orange), var(--primary-red));
            color: #fff;
            font-weight: 800;
        }

        .tx .who {
            font-weight: 600;
            color: var(--text-light);
        }

        .tx .meta {
            font-size: .85rem;
            color: var(--text-muted);
        }

        .tx .amt {
            font-weight: 700;
            color: var(--text-light);
            font-variant-numeric: tabular-nums;
        }

    .muted {
        color: var(--text-muted);
        font-weight: 500;
    }

    /* ===== Responsive Adjustments ===== */
    @@media (max-width: 1200px) {
        .grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .span-3 {
            grid-column: span 2;
        }
    }

    @@media (max-width: 768px) {
        .grid {
            grid-template-columns: 1fr;
        }

        .span-2, .span-3 {
            grid-column: span 1;
        }

        .dashboard-page {
            padding: 16px;
        }
    }
</style>

<div class="dashboard-page">
    <!-- header / breadcrumb -->
    <div class="head">
        <div class="crumb">🏠 Dashboard</div>
    </div>

    <!-- KPIs -->
    <section class="grid">
        <div class="card kpi-card">
            <div class="kpi-header">
                <div class="icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" /></svg>
                </div>
                <h3>Customers</h3>
            </div>
            <div class="big">780</div>
        </div>
        <div class="card kpi-card">
            <div class="kpi-header">
                <div class="icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zM18 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" /></svg>
                </div>
                <h3>Orders</h3>
            </div>
            <div class="big">4,780</div>
        </div>
        <div class="card kpi-card">
            <div class="kpi-header">
                <div class="icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z" /></svg>
                </div>
                <h3>Transactions</h3>
            </div>
            <div class="big">1,780</div>
        </div>
        <div class="card kpi-card">
            <div class="kpi-header">
                <div class="icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-2.5-9.5c.83 0 1.5-.67 1.5-1.5s-.67-1.5-1.5-1.5-1.5.67-1.5 1.5.67 1.5 1.5 1.5zm5 0c.83 0 1.5-.67 1.5-1.5s-.67-1.5-1.5-1.5-1.5.67-1.5 1.5.67 1.5 1.5 1.5zm-2.5 4c-1.48 0-2.75-.81-3.45-2H15c-.7 1.19-1.97 2-3.45 2z" /></svg>
                </div>
                <h3>Income</h3>
            </div>
            <div class="big">R 1,780</div>
        </div>
    </section>

    <!-- middle charts row -->
    <section class="grid">
        <div class="card span-2">
            <h3>Order Status</h3>
            <div class="chart-box">
                <svg viewBox="0 0 200 200" role="img" aria-label="Pie chart placeholder">
                    <path d="M100,100 L100,10 A90,90 0 0,1 175,145 z" fill="#ef4723" opacity="0.8" />
                    <path d="M100,100 L175,145 A90,90 0 0,1 25,145 z" fill="#1a4e95" opacity="0.8" />
                    <path d="M100,100 L25,145 A90,90 0 0,1 100,10 z" fill="#ffffff" opacity="0.8" />
                    <circle cx="100" cy="100" r="40" fill="rgba(0,0,0,0.2)" />
                </svg>
            </div>
        </div>

        <div class="card span-2">
            <h3>Monthly Revenue</h3>
            <div class="chart-box">
                <svg viewBox="0 0 320 200" role="img" aria-label="Bar chart placeholder">
                    <rect x="20" y="120" width="30" height="60" fill="#ef4723" opacity="0.8" />
                    <rect x="70" y="90" width="30" height="90" fill="#ffffff" opacity="0.8" />
                    <rect x="120" y="110" width="30" height="70" fill="#1a4e95" opacity="0.8" />
                    <rect x="170" y="60" width="30" height="120" fill="#ef4723" opacity="0.8" />
                    <rect x="220" y="100" width="30" height="80" fill="#ffffff" opacity="0.8" />
                    <rect x="270" y="70" width="30" height="110" fill="#1a4e95" opacity="0.8" />
                    <line x1="10" x2="310" y1="180" y2="180" stroke="rgba(255,255,255,0.3)" stroke-width="2" />
                </svg>
            </div>
        </div>
    </section>

    <!-- bottom: line chart + last transactions -->
    <section class="grid">
        <div class="card span-3">
            <h3>Sales Trends</h3>
            <div class="chart-box" style="height:300px;">
                <svg viewBox="0 0 600 200" role="img" aria-label="Line chart placeholder">
                    <g stroke="rgba(255,255,255,0.2)" stroke-width="1">
                        <line x1="40" x2="580" y1="170" y2="170" />
                        <line x1="40" x2="580" y1="130" y2="130" />
                        <line x1="40" x2="580" y1="90" y2="90" />
                        <line x1="40" x2="580" y1="50" y2="50" />
                    </g>
                    <polyline fill="none" stroke="#ef4723" stroke-width="3" points="40,160 140,120 240,130 340,95 440,110 540,80" />
                    <polyline fill="none" stroke="#ffffff" stroke-width="3" points="40,150 140,140 240,115 340,130 440,125 540,145" />
                </svg>
            </div>
        </div>

        <div class="card">
            <h3>Last Transactions</h3>
            <div class="list">
                <!-- Transaction #1 -->
                <div class="tx">
                    <div class="ico">💸</div>
                    <div>
                        <div class="who">Deposit</div>
                        <div class="meta">ABC Builders</div>
                    </div>
                    <div class="amt">+1,526</div>
                </div>
                <!-- Transaction #2 -->
                <div class="tx">
                    <div class="ico">🧾</div>
                    <div>
                        <div class="who">Sale</div>
                        <div class="meta">Invoice INV-10231</div>
                    </div>
                    <div class="amt">+780</div>
                </div>
                <!-- Transaction #3 -->
                <div class="tx">
                    <div class="ico">↩️</div>
                    <div>
                        <div class="who">Return</div>
                        <div class="meta">XYZ Retail</div>
                    </div>
                    <div class="amt">-120</div>
                </div>
            </div>
        </div>
    </section>
</div>