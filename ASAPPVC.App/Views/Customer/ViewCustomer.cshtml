@using ASAPPVC.App.Models
@model List<CustomerModel>
@{
    ViewData["Title"] = "Customers";
}


<link rel="stylesheet" href="~/css/Views/customer/ViewCustomer.css" asp-append-version="true" />

<div class="viewport">
    <div class="list-container">
        <!-- Toolbar -->
        <div class="toolbar">
            <form class="search-form" asp-controller="Customers" asp-action="Index" method="get">
                <input class="search-input" type="text" name="q" placeholder="Search customers..." value="@Context.Request.Query["q"]" />
                <button class="btn btn-secondary" type="submit">Search</button>
            </form>
            <a href="@Url.Action("CreateCustomer", "Customer")" class="btn btn-primary">Create New Customer</a>
        </div>

        <!-- Table -->
        <section class="table-section">
            <table class="table">
                <thead>
                    <tr>
                        <th>First name</th>
                        <th>Last name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Company</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" style="padding: 24px; text-align: center; color: var(--text-muted);">
                                No customers found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var c in Model)
                        {
                            <tr>
                                <td>@c.Name</td>
                                <td>@c.Surname</td>
                                <td>@c.PhoneNumber</td>
                                <td>@c.Email</td>
                                <td>@(string.IsNullOrWhiteSpace(c.Company) ? "—" : c.Company)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </section>
    </div>
</div>