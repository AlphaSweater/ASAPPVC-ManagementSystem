@{
    ViewData["Title"] = "Transactions";
}

@section Styles {
    <link rel="stylesheet" href="~/css/views/shared/FormCard.css" asp-append-version="true" />
}

<style>
    /* ---------- Root & Variables (Updated to match screenshot) ---------- */
    :root {
        --primary-red: #d62828;
        --primary-blue: #0d47a1;
        --hover-red: #e03a3a;
        --text-light: #ffffff;
        --text-muted: #d0cde1; 
        --border-color: rgba(224, 224, 242, 0.2);
        --container-bg: rgba(75, 59, 134, 0.25); 
        --toolbar-bg: rgba(75, 59, 134, 0.3);
        --input-bg: rgba(0, 0, 0, 0.15);
        --table-header-bg: rgba(75, 59, 134, 0.4);
    }

    /* ---------- Base & Background ---------- */
    * {
        box-sizing: border-box;
    }

    html, body {
        height: 100%;
        margin: 0;
        font-family: "Segoe UI", system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    }

    body {
        background-color: #0d47a1;
        background-image: linear-gradient(120deg, var(--primary-blue) 0%, var(--primary-red) 100%);
        color: var(--text-light);
        position: relative;
        overflow-x: hidden;
        background-attachment: fixed;
    }

    /* ---------- Main Content Container (Glassmorphism) ---------- */
    .viewport {
        padding: 40px 24px;
        min-height: 100vh;
        display: flex;
        align-items: flex-start;
        justify-content: center;
    }

    .view-container {
        width: 100%;
        max-width: 1200px;
        background: var(--container-bg);
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        border: 1px solid var(--border-color);
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        border-radius: 16px;
        padding: 32px 40px;
    }

    /* ---------- HEADER ---------- */
    .header-section {
        margin-bottom: 24px;
    }

    .main-title {
        font-weight: 700;
        font-size: 28px;
        color: var(--text-light);
        margin: 0;
    }

    /* ---------- Toolbar / Filters (Matched to Screenshot) ---------- */
    .toolbar {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 12px;
        margin-bottom: 24px;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        background: var(--toolbar-bg);
    }

    .filters {
        display: flex;
        flex-grow: 1;
        align-items: center;
        gap: 12px;
    }

    .input, select.input {
        height: 40px;
        font-size: 14px;
        color: var(--text-light);
        background: var(--input-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 0 12px;
        outline: none;
        transition: all 0.2s ease;
    }

    select.input {
        appearance: none;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%23d0cde1' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
        background-position: right 0.5rem center;
        background-repeat: no-repeat;
        background-size: 1.5em 1.5em;
        padding-right: 2.5rem;
    }

        select.input option {
            background-color: #3b2f70;
            color: var(--text-light);
        }

    .input::placeholder {
        color: var(--text-muted);
    }

    .input:focus {
        border-color: var(--text-light);
    }

    .date-separator {
        color: var(--text-muted);
    }

    /* ---------- Table Section (Matched to Screenshot) ---------- */
    .table-section {
        overflow-x: auto;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
        min-width: 800px;
    }

        .table th, .table td {
            padding: 16px;
            text-align: left;
            border-bottom: 1px solid var(--border-color);
        }

        .table thead th {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-light);
            background-color: var(--table-header-bg);
        }

        .table td {
            font-size: 15px;
            color: var(--text-muted);
        }

            .table td:first-child, .table td:nth-child(3) {
                color: var(--text-light);
                font-weight: 500;
            }

    .align-right {
        text-align: right;
    }

    /* ---------- Buttons (Matched to Screenshot) ---------- */
    .btn {
        height: 40px;
        padding: 0 24px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        border: none;
        transition: all .2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .btn:active {
            transform: scale(0.98);
        }

    .btn-primary {
        background: rgba(214, 40, 40, 0.85); 
        color: var(--text-light);
        border: 1px solid rgba(255, 100, 100, 0.5);
    }

        .btn-primary:hover {
            background: rgba(224, 58, 58, 1);
        }

    .btn-outline {
        background: transparent;
        color: var(--text-muted);
        border: 1px solid var(--border-color);
        padding: 0 16px;
        height: 34px;
    }

        .btn-outline:hover {
            background: rgba(255, 255, 255, 0.1);
            color: var(--text-light);
            border-color: rgba(255, 255, 255, 0.4);
        }

    /* ---------- Pagination (Matched to Screenshot) ---------- */
    .pagination-controls {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
        margin-top: 24px;
        padding-top: 24px;
        border-top: 1px solid var(--border-color);
    }

    .page-info {
        font-size: 14px;
        color: var(--text-muted);
    }
</style>

<div class="page">
    @await Html.PartialAsync("_BackButton")

    <div role="region" aria-labelledby="page-title">
        <header class="card-header">
            <div>
                <h1 id="page-title" class="card-title">Transactions</h1>
                <p class="card-subtitle">Search and review financial transactions.</p>
            </div>
        </header>

        <div class="card-body">
            <section class="fields-panel" style="width:100%">
                <!-- Toolbar / Filters -->
                <div class="toolbar">
                    <div class="filters">
                        <input class="input" type="text" placeholder="Search by party, reference…" style="min-width: 240px;" />
                        <select class="input">
                            <option>All Types</option>
                            <option>Sale</option>
                            <option>Purchase</option>
                            <option>Return</option>
                            <option>Adjustment</option>
                        </select>
                        <input class="input" type="date" placeholder="yyyy/mm/dd" />
                        <span class="date-separator">to</span>
                        <input class="input" type="date" placeholder="yyyy/mm/dd" />
                    </div>
                    <button type="button" class="btn btn-primary">Search</button>
                </div>

                <!-- Table -->
                <section class="table-section">
                    <table class="table">
                        <thead>
                            <tr>
                                <th style="width:110px;">ID</th>
                                <th style="width:140px;">Date</th>
                                <th>Party</th>
                                <th style="width:130px;">Type</th>
                                <th style="width:160px;">Reference</th>
                                <th style="width:140px;" class="align-right">Amount</th>
                                <th style="width:120px; text-align:center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Sample Rows -->
                            <tr>
                                <td>9001</td>
                                <td>2025-03-04</td>
                                <td>ABC Builders</td>
                                <td>Sale</td>
                                <td>INV-10231</td>
                                <td class="align-right">R 1,780.00</td>
                                <td style="text-align:center;"><a href="#" class="btn btn-outline">View</a></td>
                            </tr>
                            <tr>
                                <td>9002</td>
                                <td>2025-03-03</td>
                                <td>PipeWare Ltd.</td>
                                <td>Purchase</td>
                                <td>PO-8842</td>
                                <td class="align-right">- R 950.00</td>
                                <td style="text-align:center;"><a href="#" class="btn btn-outline">View</a></td>
                            </tr>
                            <tr>
                                <td>9003</td>
                                <td>2025-03-01</td>
                                <td>XYZ Retail</td>
                                <td>Return</td>
                                <td>RET-2205</td>
                                <td class="align-right">- R 120.00</td>
                                <td style="text-align:center;"><a href="#" class="btn btn-outline">View</a></td>
                            </tr>
                        </tbody>
                    </table>
                </section>

                <!-- Pagination -->
                <div class="pagination-controls">
                    <button type="button" class="btn btn-outline">← Previous</button>
                    <div class="page-info">Page 1 of 20</div>
                    <button type="button" class="btn btn-outline">Next →</button>
                </div>
            </section>
        </div>
    </div>
</div>