@model IEnumerable<ASAPPVC.App.Models.ComponentListVm>
@if (Model != null && Model.Any())
{
    foreach (var comp in Model)
    {
        <tr>
            <!-- Image -->
            <td class="ft-media">
                @if (comp.HasImage && !string.IsNullOrWhiteSpace(comp.ThumbUrl))
                {
                    <img src="@comp.ThumbUrl" class="ft-media__img" loading="lazy" alt="" width="52" height="52" />
                }
                else
                {
                    <div class="ft-media__placeholder" aria-hidden="true">🧩</div>
                }
            </td>

            <!-- Code (fixed, no wrap) -->
            <td class="ft-code" title="@comp.ComponentCode">
                <div class="ft-code__text">
                    <span>@comp.ComponentCode</span>
                    <button type="button" class="ft-code__copy" data-copy="@comp.ComponentCode" data-action="copy" aria-label="Copy component code">
                        <lucideIcon class="icon" name="copy" size="16" stroke-width="1.75" />
                    </button>
                </div>
            </td>

            <!-- Name (2-line clamp) -->
            <td class="ft-name" title="@comp.ComponentName">
                <span class="ft-clip ft-clip--2">@comp.ComponentName</span>
            </td>

            <!-- Location (centered) -->
            <td class="ft-location">@comp.LocationCode</td>

            <!-- Stock (right-aligned, tabular nums) -->
            <td class="ft-stock">@($"{comp.ShortFormattedQuantity}")</td>

            <!-- Cost (right-aligned, no wrap) -->
            <td class="ft-money">@comp.DisplayCost</td>

            <!-- Actions -->
            <td class="ft-actions">
                <div class="actions">
                    @if (!string.IsNullOrWhiteSpace(comp.ComponentCode))
                    {
                        <a class="btn btn-secondary btn-sm"
                           asp-area="Warehouse"
                           asp-controller="Components"
                           asp-action="DetailsByCode"
                           asp-route-code="@comp.ComponentCode"
                           aria-label="View @comp.ComponentName">
                            View
                        </a>
                        <a class="btn btn-primary btn-sm"
                           asp-area="Warehouse"
                           asp-controller="Components"
                           asp-action="EditByCode"
                           asp-route-code="@comp.ComponentCode"
                           aria-label="Edit @comp.ComponentName">
                            Edit
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-secondary btn-sm"
                           asp-area="Warehouse"
                           asp-controller="Components"
                           asp-action="DetailsById"
                           asp-route-id="@comp.Id"
                           aria-label="View @comp.ComponentName">
                            View
                        </a>
                        <a class="btn btn-primary btn-sm"
                           asp-area="Warehouse"
                           asp-controller="Components"
                           asp-action="EditById"
                           asp-route-id="@comp.Id"
                           aria-label="Edit @comp.ComponentName">
                            Edit
                        </a>
                    }
                </div>
            </td>
        </tr>
    }
}
else
{
    <tr>
        <td colspan="7" class="ft-center" role="status" style="padding:40px; color:var(--text-muted);">
            No components found.
        </td>
    </tr>
}
