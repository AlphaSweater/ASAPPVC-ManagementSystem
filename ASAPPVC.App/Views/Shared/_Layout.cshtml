@using System
@using System.Linq
@functions {
	// Simplified active-route helper: matches by controller (and optionally area)
	public static bool IsActive(string currentArea, string currentController, string? targetArea, string targetController)
	{
		var areaMatch = string.Equals(currentArea, targetArea ?? "", StringComparison.OrdinalIgnoreCase);
		var controllerMatch = string.Equals(currentController, targetController, StringComparison.OrdinalIgnoreCase);
		return areaMatch && controllerMatch;
	}
}

@{
	var area = (ViewContext.RouteData.Values["area"]?.ToString() ?? "").Trim();
	var controller = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").Trim();
	var action = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").Trim();

	var excludedRoutes = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "Auth/Login", "Auth/Register" };
	var explicitHide = ViewData["HideNavbar"] is bool b && b;
	var hideSidebar = explicitHide || excludedRoutes.Contains($"{controller}/{action}");

	var isWarehouseOpen = area.Equals("Warehouse", StringComparison.OrdinalIgnoreCase) || controller.Equals("Warehouse", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - ASAPPVC</title>

	<!-- Fonts for site.css (Montserrat) -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800&display=swap" rel="stylesheet">

	<!-- Vendor -->
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

	<!-- Global foundation (colors, gradients, typography, glass) -->
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

	<!-- Layout-only styling (positions, spacing, sidebar width, overlays, etc.) -->
	<link rel="stylesheet" href="~/css/views/shared/_Layout.css" asp-append-version="true" />

	@RenderSection("Styles", required: false)
</head>

<body class="@(hideSidebar ? "no-sidebar" : "has-sidebar")">
	@if (!hideSidebar)
	{
		<!-- Minimal mobile-only burger -->
		<button type="button" class="sb-burger" aria-label="Open navigation" aria-controls="sidebar" aria-expanded="false">☰</button>

		<aside id="sidebar" class="sidebar" role="navigation" aria-label="Primary">
			<div class="sb-brand">
				<img src="~/Assets/Images/Logos/asap-pvc-logo-dark.png" alt="ASAPPVC" />
				<span class="name">ASAPPVC</span>
			</div>

			<nav class="sb-nav">
				@*
					<a class="sb-item @(IsActive(area, controller, null, "Home") ? "active" : "")"
				   asp-area="" asp-controller="Home" asp-action="Index">
					<span class="sb-icon">🏠</span><span class="sb-label">Dashboard</span>
				</a>
			*@
				<section class="sb-group" aria-expanded="@(isWarehouseOpen ? "true" : "false")">
					<a asp-area="" asp-controller="Warehouse" asp-action="Index"
					   class="sb-toggle @(isWarehouseOpen ? "active" : "")"
					   aria-controls="grp-warehouse" aria-expanded="@(isWarehouseOpen ? "true" : "false")">
						<span class="sb-icon">🏭</span>
						<span class="sb-label">Warehouse</span>
						<img src="~/Assets/Icons/Chevrons/chevron-right.svg" alt="" class="sb-chevron" />
					</a>

					<div id="grp-warehouse" class="sb-subnav">
						<a class="sb-subitem @(IsActive(area, controller, "Warehouse", "Products") ? "active" : "")"
						   asp-area="Warehouse" asp-controller="Products" asp-action="Index">Manage Products</a>
						<a class="sb-subitem @(IsActive(area, controller, "Warehouse", "Components") ? "active" : "")"
						   asp-area="Warehouse" asp-controller="Components" asp-action="Index">Manage Components</a>
					</div>
				</section>

				<a class="sb-item @(IsActive(area, controller, null, "Order") ? "active" : "")"
				   asp-area="" asp-controller="Orders" asp-action="Index">
					<span class="sb-icon">🚚</span><span class="sb-label">Manage Orders</span>
				</a>

				<a class="sb-item @(IsActive(area, controller, null, "Customer") ? "active" : "")"
				   asp-area="" asp-controller="Customer" asp-action="ViewCustomer">
					<span class="sb-icon">👥</span><span class="sb-label">Manage Customers</span>
				</a>

			</nav>
		</aside>

		<!-- Mobile overlay (click to close) -->
		<div class="sb-overlay" hidden></div>
	}

	<div class="main">
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>

	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	<script src="~/js/views/shared/_Layout.js" asp-append-version="true"></script>

	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>