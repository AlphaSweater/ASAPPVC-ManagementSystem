@{
	ViewData["Title"] = "Login";
	// Hide site navbar for auth pages
	ViewData["HideNavbar"] = true;
}

@section Styles {
	<link rel="stylesheet" href="~/css/Views/auth/Login.css" asp-append-version="true" />
}

<div class="login-card">
	<img class="logo" src="/Assets/Images/Logos/asap-pvc-logo-dark.png" alt="A.S.A.P PVC" />
	<div class="brand-name">A.S.A.P PVC</div>

	<form asp-controller="Auth" asp-action="Login" method="post" novalidate>
		@Html.AntiForgeryToken()

		<!-- Email -->
		<div class="input-group">
			<svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M20,4H4C2.9,4,2.01,4.9,2.01,6L2,18c0,1.1,0.89,2,1.99,2H20c1.1,0,2-0.9,2-2V6C22,4.9,21.1,4,20,4z M20,8l-8,5L4,8V6l8,5 l8-5V8z" /></svg>
			<input class="input-field" type="email" name="Email" placeholder="Enter your email" autocomplete="username" />
		</div>
		@if (ViewData.ModelState["Email"]?.Errors.Count > 0)
		{
			<span class="text-danger">@ViewData.ModelState["Email"]?.Errors[0]?.ErrorMessage</span>
		}

		<!-- Password -->
		<div class="input-group">
			<svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M18,8h-1V6c0-2.76-2.24-5-5-5S7,3.24,7,6v2H6c-1.1,0-2,0.9-2,2v10c0,1.1,0.9,2,2,2h12c1.1,0,2-0.9,2-2V10C20,9.1,19.1,8,18,8z M12,17c-1.1,0-2-0.9-2-2s0.9-2,2-2s2,0.9,2,2S13.1,17,12,17z M9,8V6c0-1.65,1.35-3,3-3s3,1.35,3,3v2H9z" /></svg>
			<input class="input-field" type="password" name="Password" placeholder="Enter your password" autocomplete="current-password" />
		</div>
		@if (ViewData.ModelState["Password"]?.Errors.Count > 0)
		{
			<span class="text-danger">@ViewData.ModelState["Password"]?.Errors[0]?.ErrorMessage</span>
		}

		<!-- Options -->
		<div class="options">
			<label class="remember-me">
				<input type="checkbox" name="RememberMe" value="true" /> Remember me
			</label>
			<a href="#">Forgot Password?</a>
		</div>

		<!-- Submit Button -->
		<button type="submit" class="btn-login">LOG IN</button>

		<!-- General Errors -->
		@if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
		{
			<div class="text-danger" style="text-align:center;">
				@foreach (var e in ViewData.ModelState[string.Empty].Errors)
				{
					@e.ErrorMessage
					<br />
				}
			</div>
		}
	</form>
</div>