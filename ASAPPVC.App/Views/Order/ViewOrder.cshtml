@model ASAPPVC.App.Models.OrderDetailVm
@{
	ViewData["Title"] = $"Order #{Model.OrderCode}";
}

<style>
	/* ---------- Root & Variables ---------- */
	:root {
		--primary-red: #d62828;
		--primary-blue: #0d47a1;
		--hover-red: #e03a3a;
		--text-light: #ffffff;
		--text-muted: rgba(255, 255, 255, 0.8);
		--line: rgba(255, 255, 255, 0.2);
	}

	/* ---------- Base ---------- */
	* {
		box-sizing: border-box;
	}

	html, body {
		height: 100%;
		margin: 0;
		font-family: "Segoe UI", system-ui, -apple-system, Roboto, Helvetica, Arial, sans-serif;
	}

	body {
		background: linear-gradient(120deg, var(--primary-blue) 0%, var(--primary-red) 100%);
		color: var(--text-light);
		position: relative;
		overflow-x: hidden;
		background-attachment: fixed;
	}

		body::before, body::after {
			content: '';
			position: absolute;
			border-radius: 50%;
			filter: blur(150px);
			opacity: 0.6;
			z-index: -1;
		}

		body::before {
			background: var(--primary-blue);
			width: 350px;
			height: 350px;
			top: -80px;
			left: -120px;
		}

		body::after {
			background: var(--primary-red);
			width: 400px;
			height: 400px;
			bottom: -150px;
			right: -180px;
		}

	/* ---------- Layout ---------- */
	.viewport {
		padding: 40px 24px;
		min-height: 100vh;
	}

	.view-container {
		max-width: 1000px;
		margin: 0 auto;
		background: rgba(255, 255, 255, 0.1);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border: 1px solid var(--line);
		border-radius: 16px;
		padding: 32px 40px;
		box-shadow: 0 8px 32px 0 rgba(0,0,0,.37);
	}

	/* ---------- Header ---------- */
	.header-section {
		margin-bottom: 32px;
		padding-bottom: 24px;
		border-bottom: 1px solid var(--line);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--text-muted);
		text-decoration: none;
		font-weight: 600;
		font-size: 14px;
		margin-bottom: 16px;
		transition: color .2s ease;
	}

		.back-link:hover {
			color: var(--text-light);
		}

	.header-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
	}

	.main-title {
		font-weight: 700;
		font-size: 28px;
		color: var(--text-light);
		margin: 0;
	}

	.right-actions {
		display: flex;
		gap: 12px;
	}

	/* ---------- Info Cards ---------- */
	.order-details-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 20px;
		margin-bottom: 40px;
	}

	.info-card {
		background: rgba(255,255,255,.05);
		border: 1px solid var(--line);
		border-radius: 12px;
		padding: 16px 20px;
	}

	.label {
		font-size: 14px;
		font-weight: 500;
		color: var(--text-muted);
		margin-bottom: 6px;
	}

	.value {
		font-size: 18px;
		font-weight: 600;
		color: var(--text-light);
	}

	/* ---------- Table ---------- */
	.products-section h3 {
		font-size: 20px;
		font-weight: 600;
		margin-bottom: 16px;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--line);
	}

	.table {
		width: 100%;
		border-collapse: collapse;
	}

		.table th, .table td {
			padding: 12px 10px;
			border-bottom: 1px solid var(--line);
			text-align: left;
		}

		.table thead th {
			font-size: 14px;
			font-weight: 700;
			color: var(--text-light);
			background-color: rgba(0,0,0,.15);
		}

		.table td {
			color: var(--text-muted);
			font-size: 15px;
		}

			.table td:first-child {
				color: var(--text-light);
				font-weight: 600;
			}

	.text-end {
		text-align: right;
	}

	.total-row td {
		border-top: 2px solid var(--line);
		font-weight: 700;
		font-size: 16px;
		color: var(--text-light);
	}

	/* ---------- Buttons ---------- */
	.btn {
		height: 44px;
		padding: 0 24px;
		border-radius: 8px;
		font-weight: 600;
		font-size: 16px;
		cursor: pointer;
		border: none;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		transition: all .2s ease;
	}

		.btn:active {
			transform: scale(.98);
		}

	.btn-sm {
		height: 36px;
		padding: 0 16px;
		font-size: 14px;
	}

	.btn-primary {
		background: var(--primary-red);
		color: var(--text-light);
	}

		.btn-primary:hover {
			background: var(--hover-red);
		}

	.btn-secondary {
		background: transparent;
		color: var(--text-light);
		border: 1px solid rgba(255,255,255,.4);
	}

		.btn-secondary:hover {
			background: rgba(255,255,255,.1);
			border-color: rgba(255,255,255,.6);
		}

	.actions {
		display: flex;
		justify-content: center;
		gap: 8px;
	}
</style>

<div class="viewport">
	<div class="view-container">
		<div class="header-section">
			<a class="back-link" asp-action="ViewOrders">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="20" height="20">
					<path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 010 1.06L9.81 10l2.98 2.97a.75.75 0 11-1.06 1.06l-3.5-3.5a.75.75 0 010-1.06l3.5-3.5a.75.75 0 011.06 0z" clip-rule="evenodd" />
				</svg>
				Back to Orders
			</a>

			<div class="header-row">
				<h2 class="main-title">Order #@Model.OrderCode</h2>
				<div class="right-actions">
					<a asp-action="PickingSlip" asp-route-id="@Model.Id" class="btn btn-primary">
						Create Picking Slip
					</a>
				</div>
			</div>
		</div>

		<!-- Order Details -->
		<div class="order-details-grid">
			<div class="info-card">
				<div class="label">Customer</div>
				<div class="value">@Model.CustomerName</div>
			</div>
			<div class="info-card">
				<div class="label">Order Date</div>
				<div class="value">@Model.OrderDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
			</div>
			<div class="info-card">
				<div class="label">Status</div>
				<div class="value">@Model.OrderStatus</div>
			</div>
		</div>

		<!-- Products -->
		<section class="products-section">
			<h3>Products in this Order</h3>
			@if (Model.Products == null || !Model.Products.Any())
			{
				<p style="text-align:center; padding:40px; color: var(--text-muted);">
					No products in this order.
				</p>
			}
			else
			{
				<table class="table">
					<thead>
						<tr>
							<th>Product Code</th>
							<th>Product Name</th>
							<th class="text-end" style="width:90px;">Qty</th>
							<th class="text-end" style="width:140px;">Unit Price</th>
							<th class="text-end" style="width:160px;">Total Price</th>
							<th style="width:160px; text-align:center;">Actions</th>
						</tr>
					</thead>
					<tbody>
						@{
							decimal grandTotal = 0;
							foreach (var product in Model.Products)
							{
								var qty = product.Quantity;
								var unitPrice = product.UnitPrice;
								var totalPrice = unitPrice * qty;
								grandTotal += totalPrice;
							}
						}
						@foreach (var product in Model.Products)
						{
							var qty = product.Quantity;
							var unitPrice = product.UnitPrice;
							var totalPrice = unitPrice * qty;
							<tr>
								<td>@product.ProductCode</td>
								<td>@product.ProductName</td>
								<td class="text-end">@qty</td>
								<td class="text-end">@unitPrice.ToString("C")</td>
								<td class="text-end">@totalPrice.ToString("C")</td>
								<td>
									<div class="actions">
										<a class="btn btn-secondary btn-sm"
										   asp-controller="Inventory"
										   asp-action="ViewProduct"
										   asp-route-id="@(product.ProductId)">
											View
										</a>
									</div>
								</td>
							</tr>
						}
						<tr class="total-row">
							<td colspan="3" class="text-end">Order Total:</td>
							<td class="text-end">@((Model.Products?.Sum(op => (op.UnitPrice) * op.Quantity) ?? 0m).ToString("C"))</td>
							<td></td>
						</tr>
					</tbody>
				</table>
			}
		</section>
	</div>
</div>